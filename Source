	-- floating toggle pill (auto-enabled on touch devices; MobileButton=true/false to force)
	if cfg.MobileButton == true or (cfg.MobileButton == nil and UIS.TouchEnabled) then
		floatBtn = New("TextButton", {
			Name = "ToggleButton", Size = UDim2.new(0, 0, 0, 34), AutomaticSize = Enum.AutomaticSize.X,
