-- ========================================================== helpers
local function New(class, props, children)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do inst[k] = v end
	for _, c in ipairs(children or {}) do c.Parent = inst end
	return inst
end
local function Corner(r) return New("UICorner", { CornerRadius = UDim.new(0, r or 3) }) end
local function Stroke(color, th)
	return New("UIStroke", { Color = color or Theme.Border, Thickness = th or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end
local function Pad(l, t, r, b)
	return New("UIPadding", { PaddingLeft = UDim.new(0, l or 0), PaddingTop = UDim.new(0, t or 0), PaddingRight = UDim.new(0, r or 0), PaddingBottom = UDim.new(0, b or 0) })
end
local function List(pad, dir)
	return New("UIListLayout", { Padding = UDim.new(0, pad or 0), FillDirection = dir or Enum.FillDirection.Vertical, SortOrder = Enum.SortOrder.LayoutOrder })
end
local function Tween(obj, props, t)
	TweenService:Create(obj, TweenInfo.new(t or 0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end
local function Label(props)
	props.BackgroundTransparency = 1
	props.Font = props.Font or Theme.Font
	props.TextSize = props.TextSize or 9
	props.TextColor3 = props.TextColor3 or Theme.Text
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	return New("TextLabel", props)
end
local function Hex(c)
	return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end
local function OnAccent(fn) table.insert(NeverRage._onAccent, fn) end

local function Mount(gui)
	pcall(function()
		local root = (gethui and gethui()) or game:GetService("CoreGui")
		local old = root:FindFirstChild(gui.Name)
		if old then old:Destroy() end
	end)
	local ok = pcall(function() gui.Parent = (gethui and gethui()) or game:GetService("CoreGui") end)
	if not ok or not gui.Parent then
		gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	end
end

local function Register(flag, obj, default)
	if flag then
		NeverRage.Flags[flag] = default
		NeverRage.Objects[flag] = obj
	end
end
local function Fire(flag, cb, v)
	if flag then NeverRage.Flags[flag] = v end
	if cb then
		task.spawn(function()
			local ok, err = pcall(cb, v)
			if not ok then warn("[NeverRage] callback error: " .. tostring(err)) end
		end)
	end
end

-- a line segment drawn with a rotated frame
local function Seg(parent, x1, y1, x2, y2, th, color)
	local dx, dy = x2 - x1, y2 - y1
	local len = math.sqrt(dx * dx + dy * dy)
	local f = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2),
		Size = UDim2.fromOffset(len + th * 0.6, th),
		Rotation = math.deg(math.atan2(dy, dx)),
		BackgroundColor3 = color, BorderSizePixel = 0, Parent = parent,
	})
	New("UICorner", { CornerRadius = UDim.new(0.5, 0) }).Parent = f
	return f
end

-- tiny UI glyphs (check, chevrons, window buttons) drawn from frames, no fonts/assets needed
local function Glyph(kind, parent, size, color, x, y)
	local k = size / 10
	local holder = New("Frame", { Size = UDim2.fromOffset(size, size), Position = UDim2.fromOffset(x or 0, y or 0), BackgroundTransparency = 1, Parent = parent })
	local parts, strokes = {}, {}
	local function seg(x1, y1, x2, y2, th)
		parts[#parts + 1] = Seg(holder, x1 * k, y1 * k, x2 * k, y2 * k, (th or 1.3) * k, color)
	end
	if kind == "check" then seg(1.6, 5.2, 4, 7.6, 1.6); seg(4, 7.6, 8.6, 2.4, 1.6)
	elseif kind == "down" then seg(1.5, 3.2, 5, 6.8, 1.3); seg(5, 6.8, 8.5, 3.2, 1.3)
	elseif kind == "up" then seg(1.5, 6.8, 5, 3.2, 1.3); seg(5, 3.2, 8.5, 6.8, 1.3)
	elseif kind == "right" then seg(3.2, 1.5, 6.8, 5, 1.4); seg(6.8, 5, 3.2, 8.5, 1.4)
	elseif kind == "close" then seg(1.5, 1.5, 8.5, 8.5, 1.2); seg(8.5, 1.5, 1.5, 8.5, 1.2)
	elseif kind == "minimize" then seg(1, 5, 9, 5, 1.2)
	elseif kind == "maximize" then
		local b = New("Frame", { Position = UDim2.fromOffset(1.5 * k, 1.5 * k), Size = UDim2.fromOffset(7 * k, 7 * k), BackgroundTransparency = 1, Parent = holder }, { Corner(1) })
		strokes[1] = New("UIStroke", { Color = color, Thickness = 1.1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = b })
	end
	return {
		Holder = holder,
		SetColor = function(c)
			for _, p in ipairs(parts) do p.BackgroundColor3 = c end
			for _, s in ipairs(strokes) do s.Color = c end
		end,
	}
end

