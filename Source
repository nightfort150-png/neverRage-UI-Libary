local function BuildIcon(name, parent, size, color, x, y)
	if type(name) == "number" then name = "rbxassetid://" .. name end
	if type(name) == "string" and name:find("rbxassetid") then
		local img = New("ImageLabel", { Size = UDim2.fromOffset(size, size), Position = UDim2.fromOffset(x or 0, y or 0), BackgroundTransparency = 1, Image = name, ImageColor3 = color, Parent = parent })
		return { Holder = img, SetColor = function(c) img.ImageColor3 = c end }
	end
	local def = IconDefs[name] or IconDefs.dots
	local k = size / 14
	local holder = New("Frame", { Size = UDim2.fromOffset(size, size), Position = UDim2.fromOffset(x or 0, y or 0), BackgroundTransparency = 1, Parent = parent })
	local fills, strokes = {}, {}
	local function box(bx, by, bw, bh, o)
		o = o or {}
		local f = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset((bx + bw / 2) * k, (by + bh / 2) * k),
			Size = UDim2.fromOffset(bw * k, bh * k),
			Rotation = o.rot or 0, BorderSizePixel = 0, Parent = holder,
		})
		if o.round then New("UICorner", { CornerRadius = UDim.new(0, o.round * k) }).Parent = f end
		if o.stroke then
			f.BackgroundTransparency = 1
			strokes[#strokes + 1] = New("UIStroke", { Color = color, Thickness = math.max(1, o.stroke * k), ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = f })
		else
			f.BackgroundColor3 = color
			fills[#fills + 1] = f
		end
	end
	local function line(x1, y1, x2, y2, th)
		fills[#fills + 1] = Seg(holder, x1 * k, y1 * k, x2 * k, y2 * k, th * k, color)
	end
	def(box, line)
	return {
		Holder = holder,
		SetColor = function(c)
			for _, f in ipairs(fills) do f.BackgroundColor3 = c end
			for _, s in ipairs(strokes) do s.Color = c end
		end,
	}
end

-- ========================================================== accent / config
function NeverRage:SetAccent(c)
	Theme.Accent = c
	for _, fn in ipairs(self._onAccent) do pcall(fn) end
end

local function ser(v)
	local t = typeof(v)
	if t == "Color3" then return { __color = { v.R, v.G, v.B } } end
	if t == "table" then
		local a = {}
		for k, on in pairs(v) do if on then table.insert(a, k) end end
		table.sort(a)
		return { __multi = a }
	end
	if t == "EnumItem" then return v.Name end
	return v
end
local function deser(v)
	if type(v) == "table" then
		if v.__color then return Color3.new(v.__color[1], v.__color[2], v.__color[3]) end
		if v.__multi then
			local m = {}
			for _, k in ipairs(v.__multi) do m[k] = true end
			return m
		end
	end
	return v
end
function NeverRage:ExportConfig()
	local out = {}
	for k, v in pairs(self.Flags) do out[k] = ser(v) end
	return HttpService:JSONEncode(out)
end
function NeverRage:ImportConfig(json)
	local ok, data = pcall(function() return HttpService:JSONDecode(json) end)
	if not ok or type(data) ~= "table" then return false end
	for k, v in pairs(data) do
		local o = self.Objects[k]
		if o then pcall(function() o:Set(deser(v)) end) end
	end
	return true
end
function NeverRage:Notify(n)
	if self.Windows[1] then self.Windows[1]:Notify(n) end
end
function NeverRage:Unload()
	for i = #self.Windows, 1, -1 do self.Windows[i]:Destroy() end
end

-- ========================================================== window
function NeverRage:CreateWindow(cfg)
	cfg = cfg or {}
	if cfg.Accent then Theme.Accent = cfg.Accent end
	local W, H, TH, SW = 680, 430, 36, 122

	local Window = { Tabs = {}, Active = nil, ToggleKey = cfg.ToggleKey or Enum.KeyCode.RightShift }
	local conns = {}
	local function conn(sig, fn) conns[#conns + 1] = sig:Connect(fn) end

	local gui = New("ScreenGui", { Name = "NeverRage_" .. (cfg.Id or "UI"), ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = true, DisplayOrder = 100 })
	Mount(gui)
	Window.Gui = gui

	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local baseScale = math.min(cfg.Scale or 1.3, vp.X * 0.94 / W, vp.Y * 0.94 / H)

	local main = New("Frame", {
		Name = "Main", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(W, H), BackgroundColor3 = Theme.Window, BorderSizePixel = 0, ClipsDescendants = true, Parent = gui,
	}, { Corner(4), Stroke(Theme.Border) })
	local uiScale = New("UIScale", { Scale = baseScale, Parent = main })

	-- rainbow bar
	local bar = New("Frame", { Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 10, Parent = main })
	New("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 70, 110)),
			ColorSequenceKeypoint.new(0.22, Color3.fromRGB(255, 190, 50)),
			ColorSequenceKeypoint.new(0.42, Color3.fromRGB(90, 235, 120)),
			ColorSequenceKeypoint.new(0.62, Color3.fromRGB(60, 190, 255)),
			ColorSequenceKeypoint.new(0.82, Color3.fromRGB(150, 90, 255)),
			ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 70, 200)),
		}),
		Parent = bar,
	})

	-- title bar
	local titlebar = New("Frame", { Size = UDim2.new(1, 0, 0, TH), BackgroundColor3 = Theme.Sidebar, BorderSizePixel = 0, Parent = main })
	New("Frame", { Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, -1), BackgroundColor3 = Theme.Line, BorderSizePixel = 0, Parent = titlebar })

	local brand = New("Frame", { Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Position = UDim2.fromOffset(13, 1), BackgroundTransparency = 1, Parent = titlebar },
		{ New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 7), VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }) })
	local function titleText()
		return (cfg.Title or "Never") .. "<font color=\"" .. Hex(Theme.Accent) .. "\">" .. (cfg.TitleAccent or "Rage") .. "</font>"
	end
	local logo = Label({ Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, RichText = true, Text = titleText(), Font = Theme.FontBold, TextSize = 12, LayoutOrder = 0, Parent = brand })
	local tag = New("Frame", { Size = UDim2.new(0, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.XY, BackgroundColor3 = Theme.Element, BorderSizePixel = 0, LayoutOrder = 1, Parent = brand },
		{ Corner(3), Stroke(Theme.Border), Pad(5, 2, 5, 2) })
	Label({ Size = UDim2.new(0, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.XY, Text = cfg.Tag or "v1.0", TextSize = 7, TextColor3 = Theme.SubText, Parent = tag })

	-- window buttons
	local btns = New("Frame", { Size = UDim2.fromOffset(78, TH), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 1), BackgroundTransparency = 1, Parent = titlebar },
		{ New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder }) })
	local minimized, maximized = false, false
	local floatBtn
	local function winButton(kind, order, hover, fn)
		local b = New("TextButton", { Size = UDim2.fromOffset(26, TH - 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, LayoutOrder = order, Parent = btns })
		local g = Glyph(kind, b, 8, Theme.SubText, 9, 14)
		b.MouseEnter:Connect(function() g.SetColor(hover) end)
		b.MouseLeave:Connect(function() g.SetColor(Theme.SubText) end)
		b.MouseButton1Click:Connect(fn)
	end

	-- dragging
	do
		local dragging, start, startPos
		titlebar.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				dragging, start, startPos = true, i.Position, main.Position
			end
		end)
		conn(UIS.InputChanged, function(i)
			if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
				local d = i.Position - start
				main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			end
		end)
		conn(UIS.InputEnded, function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
		end)
	end

	-- sidebar
	local sidebar = New("Frame", { Size = UDim2.new(0, SW, 1, -TH), Position = UDim2.fromOffset(0, TH), BackgroundColor3 = Theme.Sidebar, BorderSizePixel = 0, Parent = main })
	New("Frame", { Size = UDim2.new(0, 1, 1, 0), Position = UDim2.new(1, -1, 0, 0), BackgroundColor3 = Theme.Line, BorderSizePixel = 0, Parent = sidebar })
	local tabList = New("ScrollingFrame", {
		Size = UDim2.new(1, -1, 1, -28), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 0,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = sidebar,
	}, { List(2), Pad(0, 6, 0, 6) })
	Label({ Size = UDim2.new(1, -20, 0, 20), AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 14, 1, -4), Text = cfg.Footer or "NeverRage UI", TextSize = 7, TextColor3 = Theme.Dim, Parent = sidebar })

	local content = New("Frame", { Size = UDim2.new(1, -SW, 1, -TH), Position = UDim2.fromOffset(SW, TH), BackgroundColor3 = Theme.Content, BorderSizePixel = 0, Parent = main })

	winButton("minimize", 0, Theme.Text, function()
		minimized = not minimized
		sidebar.Visible = not minimized
		content.Visible = not minimized
		main.Size = UDim2.fromOffset(W, minimized and TH or H)
	end)
	winButton("maximize", 1, Theme.Text, function()
		maximized = not maximized
		uiScale.Scale = maximized and math.min(baseScale * 1.25, vp.X * 0.97 / W, vp.Y * 0.97 / H) or baseScale
	end)
	winButton("close", 2, Theme.Accent, function()
		if floatBtn then Window:Toggle() else Window:Destroy() end
	end)

	-- toasts
	local toasts = New("Frame", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -18, 1, -18), Size = UDim2.fromOffset(250, 420), BackgroundTransparency = 1, Parent = gui },
		{ New("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Bottom, HorizontalAlignment = Enum.HorizontalAlignment.Right }) })

	function Window:Notify(n)
		if type(n) == "string" then n = { Text = n } end
		n = n or {}
		local t = New("CanvasGroup", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Theme.Element, BorderSizePixel = 0, GroupTransparency = 1, Parent = toasts }, { Corner(4), Stroke() })
		New("Frame", { Size = UDim2.new(0, 2, 1, 0), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Parent = t })
		local inner = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = t }, { Pad(14, 9, 10, 9), List(2) })
		Label({ Size = UDim2.new(1, 0, 0, 13), Text = n.Title or "NeverRage", Font = Theme.FontBold, TextSize = 10, LayoutOrder = 0, Parent = inner })
		Label({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Text = n.Text or "", TextWrapped = true, TextSize = 9, TextColor3 = Theme.SubText, LayoutOrder = 1, Parent = inner })
		Tween(t, { GroupTransparency = 0 }, 0.25)
		task.delay(n.Duration or 4, function()
			if t.Parent then
				Tween(t, { GroupTransparency = 1 }, 0.3)
				task.wait(0.35)
				t:Destroy()
			end
		end)
	end

	-- floating toggle button (auto-enabled on touch devices; MobileButton=true/false to force)
	if cfg.MobileButton == true or (cfg.MobileButton == nil and UIS.TouchEnabled) then
		floatBtn = New("TextButton", {
			Name = "ToggleButton", Size = UDim2.fromOffset(42, 42), Position = UDim2.new(0, 14, 0.5, -21),
			BackgroundColor3 = Theme.Element, Text = "", AutoButtonColor = false, ZIndex = 20, Parent = gui,
		}, { Corner(21) })
		local fstroke = Stroke(Theme.Accent, 1.5); fstroke.Parent = floatBtn
		local fletter = Label({
			Size = UDim2.fromScale(1, 1), Text = cfg.ButtonText or string.sub(cfg.Title or "N", 1, 1), Font = Theme.FontBold,
			TextSize = 17, TextColor3 = Theme.Accent, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 21, Parent = floatBtn,
		})
		OnAccent(function() fstroke.Color = Theme.Accent; fletter.TextColor3 = Theme.Accent end)

		local fdrag, moved, fstart, fpos = false, false, nil, nil
		floatBtn.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				fdrag, moved, fstart, fpos = true, false, i.Position, floatBtn.Position
			end
		end)
		conn(UIS.InputChanged, function(i)
			if fdrag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
				local d = i.Position - fstart
				if d.Magnitude > 6 then moved = true end
				if moved then
					floatBtn.Position = UDim2.new(fpos.X.Scale, fpos.X.Offset + d.X, fpos.Y.Scale, fpos.Y.Offset + d.Y)
				end
			end
		end)
		conn(UIS.InputEnded, function(i)
			if fdrag and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
				fdrag = false
				if not moved then Window:Toggle() end
			end
		end)
	end

	-- menu toggle key
	conn(UIS.InputBegan, function(i, gp)
		if gp or NeverRage._listening then return end
		if i.KeyCode == Window.ToggleKey then Window:Toggle() end
	end)

	function Window:SetVisible(v) main.Visible = v end
	function Window:Toggle() main.Visible = not main.Visible end
	function Window:SetToggleKey(k) Window.ToggleKey = k end
	function Window:Destroy()
		for _, c in ipairs(conns) do c:Disconnect() end
		conns = {}
		gui:Destroy()
		for i, w in ipairs(NeverRage.Windows) do if w == Window then table.remove(NeverRage.Windows, i) break end end
	end
	function Window:SelectTab(tab)
		for _, t in ipairs(Window.Tabs) do t:_render(t == tab) end
		Window.Active = tab
	end

