				local l = Label({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Text = text or "", TextWrapped = true, TextSize = 9, TextColor3 = Theme.SubText, LayoutOrder = nextOrder(), Parent = sec })
				return { Set = function(_, t) l.Text = t end, Get = function() return l.Text end }
			end
			function Section:AddSeparator()
