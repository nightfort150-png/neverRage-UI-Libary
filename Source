	local content = New("Frame", { Size = UDim2.new(1, -SW, 1, -TH), Position = UDim2.fromOffset(SW, TH), BackgroundColor3 = Theme.Content, BackgroundTransparency = 0.22, BorderSizePixel = 0, Parent = main })

