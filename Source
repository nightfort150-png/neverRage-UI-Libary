				Register(c.Flag, obj, value)
				OnAccent(render)
				render()
				return obj
			end

			-- ---------------------------------------------- slider
			function Section:AddSlider(c)
				spacer("slider")
				local min, max, inc = c.Min or 0, c.Max or 100, c.Increment or 1
				local suffix = c.Suffix or ""
				local decimals = 0
				local istr = tostring(inc)
				local dot = istr:find("%.")
				if dot then decimals = #istr - dot end
				local value = math.clamp(c.Default or min, min, max)

				local frame = New("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, LayoutOrder = nextOrder(), Parent = sec })
				Label({ Size = UDim2.new(0.65, 0, 0, 12), Text = c.Name or "Slider", TextSize = 9, TextColor3 = Theme.MidText, Parent = frame })
				local vlabel = Label({ Size = UDim2.new(0.35, 0, 0, 12), Position = UDim2.fromScale(0.65, 0), TextSize = 8, TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Right, Parent = frame })
				local track = New("Frame", { Size = UDim2.new(1, 0, 0, 3), Position = UDim2.fromOffset(0, 20), BackgroundColor3 = Theme.Track, BorderSizePixel = 0, Parent = frame }, { Corner(2) })
				local fill = New("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Parent = track }, { Corner(2) })
				local knob = New("Frame", { Size = UDim2.fromOffset(7, 7), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, ZIndex = 2, Parent = track }, { Corner(4) })

				local obj = {}
				local function render()
					local a = (max == min) and 0 or (value - min) / (max - min)
					fill.Size = UDim2.fromScale(a, 1)
					knob.Position = UDim2.fromScale(a, 0.5)
					fill.BackgroundColor3 = Theme.Accent
					knob.BackgroundColor3 = Theme.Accent
					vlabel.Text = string.format("%." .. decimals .. "f", value) .. suffix
				end
				function obj:Set(v)
					v = math.clamp(math.floor(v / inc + 0.5) * inc, min, max)
					value = tonumber(string.format("%.6f", v))
					render(); Fire(c.Flag, c.Callback, value)
				end
				function obj:Get() return value end

				local dragging = false
				local function fromX(x)
					local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
					obj:Set(min + (max - min) * a)
				end
				frame.InputBegan:Connect(function(i)
					if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
						dragging = true; fromX(i.Position.X)
					end
				end)
				conn(UIS.InputChanged, function(i)
					if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then fromX(i.Position.X) end
				end)
				conn(UIS.InputEnded, function(i)
					if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
				end)
				Register(c.Flag, obj, value)
				OnAccent(render)
				render()
				return obj
			end

			-- ---------------------------------------------- dropdown (single or multi)
			function Section:AddDropdown(c)
				spacer("dropdown")
				local multi = c.Multi and true or false
				local options = c.Options or {}
				local value
				if multi then
					value = {}
					for _, d in ipairs(c.Default or {}) do value[d] = true end
				else
					value = c.Default or options[1]
				end

				local wrap = wrapper()
				local row = New("Frame", { Size = UDim2.new(1, 0, 0, 19), BackgroundTransparency = 1, LayoutOrder = 0, Parent = wrap })
				rowLabel(row, c.Name or "Dropdown")
				local head = New("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0.693, 0, 1, 0), BackgroundColor3 = Theme.Element, Text = "", AutoButtonColor = false, Parent = row }, { Corner(3), Stroke() })
				local sel = Label({ Size = UDim2.new(1, -26, 1, 0), Position = UDim2.fromOffset(8, 0), TextSize = 9, TextTruncate = Enum.TextTruncate.AtEnd, Parent = head })
				local arrow = Glyph("down", head, 7, Theme.SubText, 0, 6)
				arrow.Holder.AnchorPoint = Vector2.new(0.5, 0.5)
				arrow.Holder.Position = UDim2.new(1, -12.5, 0.5, 0)

				local listFrame = New("Frame", { Size = UDim2.new(0.693, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Theme.Element, Visible = false, LayoutOrder = 1, Parent = wrap }, { Corner(3), Stroke(), List(0) })
				local obj = {}
				local open = false

				local function display()
					if multi then
						local names = {}
						for _, o in ipairs(options) do if value[o] then table.insert(names, tostring(o)) end end
						sel.Text = (#names > 0) and table.concat(names, ", ") or "None"
					else
						sel.Text = tostring(value)
					end
				end
				local function isOn(o) if multi then return value[o] == true end return value == o end
				local itemLabels = {}
				local function paint()
					for o, l in pairs(itemLabels) do l.TextColor3 = isOn(o) and Theme.Accent or Theme.SubText end
				end
				local function setOpen(v)
					open = v
					listFrame.Visible = v
					arrow.Holder.Rotation = v and 180 or 0
				end
				function obj:Refresh(newOptions)
					options = newOptions or options
					for _, ch in ipairs(listFrame:GetChildren()) do if ch:IsA("TextButton") then ch:Destroy() end end
					itemLabels = {}
					if not multi and value ~= nil then
						local found = false
						for _, o in ipairs(options) do if o == value then found = true end end
						if not found then value = options[1] end
					end
					for idx, o in ipairs(options) do
						local b = New("TextButton", { Size = UDim2.new(1, 0, 0, 19), BackgroundColor3 = Theme.Element2, BackgroundTransparency = 1, Text = "", AutoButtonColor = false, LayoutOrder = idx, Parent = listFrame })
						itemLabels[o] = Label({ Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromOffset(8, 0), Text = tostring(o), TextSize = 9, TextColor3 = Theme.SubText, Parent = b })
						b.MouseEnter:Connect(function() b.BackgroundTransparency = 0.4 end)
						b.MouseLeave:Connect(function() b.BackgroundTransparency = 1 end)
						b.MouseButton1Click:Connect(function()
							if multi then
								value[o] = (not value[o]) or nil
								display(); paint(); Fire(c.Flag, c.Callback, value)
							else
								obj:Set(o); setOpen(false)
							end
						end)
					end
					display(); paint()
				end
				function obj:Set(v)
					if multi then
						local m = {}
						if type(v) == "table" then
							if v[1] ~= nil then for _, k in ipairs(v) do m[k] = true end
							else for k, on in pairs(v) do if on then m[k] = true end end end
						end
						value = m
					else
						value = v
					end
					display(); paint(); Fire(c.Flag, c.Callback, value)
				end
				function obj:Get() return value end
				head.MouseButton1Click:Connect(function() setOpen(not open) end)
				obj:Refresh(options)
				Register(c.Flag, obj, value)
				return obj
			end

			-- ---------------------------------------------- color picker (hue wheel + SV square)
			function Section:AddColorPicker(c)
				spacer("color")
				local color = c.Default or Color3.fromRGB(255, 255, 255)
				local h, s, v = color:ToHSV()

				local wrap = wrapper()
				local row = New("Frame", { Size = UDim2.new(1, 0, 0, 19), BackgroundTransparency = 1, LayoutOrder = 0, Parent = wrap })
				rowLabel(row, c.Name or "Color")
				local swatch = New("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(30, 13), BackgroundColor3 = color, Text = "", AutoButtonColor = false, Parent = row }, { Corner(3), Stroke() })
				local panel = New("Frame", { Size = UDim2.new(1, 0, 0, 134), BackgroundColor3 = Theme.Element, Visible = false, LayoutOrder = 1, Parent = wrap }, { Corner(4), Stroke() })

				local obj = {}
				local built = false
				local sq, sqBase, svCursor, hueMarker, preview, rgbLabels, hexBox
				local D, R = 112, 51

				local function apply(fire)
					color = Color3.fromHSV(h, s, v)
					swatch.BackgroundColor3 = color
					if built then
						sqBase.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
						svCursor.Position = UDim2.fromScale(s, 1 - v)
						local a = h * math.pi * 2
						hueMarker.Position = UDim2.fromOffset(D / 2 + math.cos(a) * R, D / 2 + math.sin(a) * R)
						preview.BackgroundColor3 = color
						rgbLabels[1].Text = "R   " .. math.floor(color.R * 255 + 0.5)
						rgbLabels[2].Text = "G   " .. math.floor(color.G * 255 + 0.5)
						rgbLabels[3].Text = "B   " .. math.floor(color.B * 255 + 0.5)
						hexBox.Text = Hex(color)
					end
					if fire then Fire(c.Flag, c.Callback, color) end
				end

				local function build()
					built = true
					local wheel = New("Frame", { Size = UDim2.fromOffset(D, D), Position = UDim2.fromOffset(10, 11), BackgroundTransparency = 1, Parent = panel })
					local N = 90
					for i = 0, N - 1 do
						local a = (i / N) * math.pi * 2
						New("Frame", {
							AnchorPoint = Vector2.new(0.5, 0.5),
							Position = UDim2.fromOffset(D / 2 + math.cos(a) * R, D / 2 + math.sin(a) * R),
							Size = UDim2.fromOffset(10, 5), Rotation = math.deg(a),
							BackgroundColor3 = Color3.fromHSV(i / N, 1, 1), BorderSizePixel = 0, Parent = wheel,
						})
					end
					sq = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(D / 2, D / 2), Size = UDim2.fromOffset(60, 60), BackgroundTransparency = 1, Parent = wheel })
					sqBase = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromHSV(h, 1, 1), BorderSizePixel = 0, Parent = sq }, { Corner(2) })
					local white = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = sqBase }, { Corner(2) })
					New("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = white })
					local black = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Parent = sqBase }, { Corner(2) })
					New("UIGradient", { Transparency = NumberSequence.new(1, 0), Rotation = 90, Parent = black })
					svCursor = New("Frame", { Size = UDim2.fromOffset(7, 7), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 3, Parent = sqBase }, { Corner(4), Stroke(Color3.new(1, 1, 1), 1.2) })
					hueMarker = New("Frame", { Size = UDim2.fromOffset(9, 9), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 3, Parent = wheel }, { Corner(5), Stroke(Color3.new(1, 1, 1), 1.4) })

					local cap = New("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 6, Parent = wheel })

					-- right side info
					preview = New("Frame", { Position = UDim2.fromOffset(134, 12), Size = UDim2.fromOffset(84, 22), BackgroundColor3 = color, BorderSizePixel = 0, Parent = panel }, { Corner(3), Stroke() })
					rgbLabels = {}
					for i = 1, 3 do
						rgbLabels[i] = Label({ Position = UDim2.fromOffset(136, 40 + (i - 1) * 16), Size = UDim2.fromOffset(80, 14), Text = "", TextSize = 9, TextColor3 = Theme.MidText, Parent = panel })
					end
					hexBox = New("TextBox", {
						Position = UDim2.fromOffset(134, 98), Size = UDim2.fromOffset(84, 22), BackgroundColor3 = Theme.Element2, BorderSizePixel = 0,
						Text = "", Font = Theme.Font, TextSize = 9, TextColor3 = Theme.Text, ClearTextOnFocus = false, Parent = panel,
					}, { Corner(3), Stroke() })
					hexBox.FocusLost:Connect(function()
						local t = hexBox.Text:gsub("#", "")
						if #t == 6 and t:match("^%x%x%x%x%x%x$") then
							local nc = Color3.fromRGB(tonumber(t:sub(1, 2), 16), tonumber(t:sub(3, 4), 16), tonumber(t:sub(5, 6), 16))
							h, s, v = nc:ToHSV()
						end
						apply(true)
					end)

					-- interaction
					local mode
					local function update(pos)
						local p = Vector2.new(pos.X, pos.Y)
						if mode == "hue" then
							local vec = p - (wheel.AbsolutePosition + wheel.AbsoluteSize / 2)
							h = ((math.atan2(vec.Y, vec.X) / (math.pi * 2)) + 1) % 1
						elseif mode == "sv" then
							local rel = (p - sq.AbsolutePosition) / sq.AbsoluteSize
							s = math.clamp(rel.X, 0, 1)
							v = 1 - math.clamp(rel.Y, 0, 1)
						end
						apply(true)
					end
					cap.InputBegan:Connect(function(i)
						if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
							local p = Vector2.new(i.Position.X, i.Position.Y)
							local rel = (p - sq.AbsolutePosition) / sq.AbsoluteSize
							local r = (p - (wheel.AbsolutePosition + wheel.AbsoluteSize / 2)).Magnitude / (wheel.AbsoluteSize.X / 2)
							if rel.X >= 0 and rel.X <= 1 and rel.Y >= 0 and rel.Y <= 1 then mode = "sv"
							elseif r > 0.62 and r <= 1.12 then mode = "hue"
							else mode = nil end
							if mode then update(i.Position) end
						end
					end)
					conn(UIS.InputChanged, function(i)
						if mode and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then update(i.Position) end
					end)
					conn(UIS.InputEnded, function(i)
						if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then mode = nil end
					end)
					apply(false)
				end

				swatch.MouseButton1Click:Connect(function()
					panel.Visible = not panel.Visible
					if panel.Visible and not built then build() end
				end)
				function obj:Set(nc)
					if typeof(nc) == "table" and nc.__color then nc = Color3.new(nc.__color[1], nc.__color[2], nc.__color[3]) end
					if typeof(nc) ~= "Color3" then return end
					h, s, v = nc:ToHSV()
					apply(true)
				end
				function obj:Get() return color end
				Register(c.Flag, obj, color)
				return obj
			end

			-- ---------------------------------------------- keybind
			function Section:AddKeybind(c)
				spacer("keybind")
				local key = c.Default
				if type(key) == "string" then key = Enum.KeyCode[key] end
				local listening = false

				local row = New("Frame", { Size = UDim2.new(1, 0, 0, 19), BackgroundTransparency = 1, LayoutOrder = nextOrder(), Parent = sec })
				rowLabel(row, c.Name or "Keybind")
				local box = New("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0.34, 0, 1, 0), BackgroundColor3 = Theme.Element, Text = "", AutoButtonColor = false, Parent = row }, { Corner(3), Stroke() })
				local txt = Label({ Size = UDim2.fromScale(1, 1), Text = "", TextSize = 9, TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd, Parent = box })

				local obj = {}
				local function render()
					txt.Text = listening and "..." or (key and key.Name or "None")
					txt.TextColor3 = listening and Theme.Accent or Theme.SubText
				end
				function obj:Set(k)
					if type(k) == "string" then k = (k ~= "None") and Enum.KeyCode[k] or nil end
					key = k
					render()
					Fire(c.Flag, nil, key and key.Name or "None")
					if c.Changed then task.spawn(c.Changed, key) end
				end
				function obj:Get() return key end
				box.MouseButton1Click:Connect(function()
					listening = true
					NeverRage._listening = true
					render()
				end)
				conn(UIS.InputBegan, function(i, gp)
					if listening then
						if i.UserInputType == Enum.UserInputType.Keyboard then
							listening = false
							task.delay(0.1, function() NeverRage._listening = false end)
							if i.KeyCode == Enum.KeyCode.Escape then obj:Set(nil) else obj:Set(i.KeyCode) end
						end
					elseif key and not gp and i.KeyCode == key and c.Callback then
						task.spawn(c.Callback, key)
					end
				end)
				Register(c.Flag, obj, key and key.Name or "None")
				render()
				return obj
			end

			-- ---------------------------------------------- textbox
			function Section:AddTextBox(c)
				spacer("textbox")
				local value = c.Default or ""
				local row = New("Frame", { Size = UDim2.new(1, 0, 0, 19), BackgroundTransparency = 1, LayoutOrder = nextOrder(), Parent = sec })
				rowLabel(row, c.Name or "Text")
				local tb = New("TextBox", {
					AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0.693, 0, 1, 0),
					BackgroundColor3 = Theme.Element, BorderSizePixel = 0, Text = value, PlaceholderText = c.Placeholder or "", PlaceholderColor3 = Theme.Dim,
					Font = Theme.Font, TextSize = 9, TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, Parent = row,
				}, { Corner(3), Stroke(), Pad(8, 0, 8, 0) })
				local obj = {}
				function obj:Set(t) value = tostring(t); tb.Text = value; Fire(c.Flag, c.Callback, value) end
				function obj:Get() return value end
				tb.FocusLost:Connect(function() value = tb.Text; Fire(c.Flag, c.Callback, value) end)
				Register(c.Flag, obj, value)
				return obj
			end

			-- ---------------------------------------------- button
			function Section:AddButton(c)
				spacer("button")
				local b = New("TextButton", { Size = UDim2.new(1, 0, 0, 21), BackgroundColor3 = Theme.Element, Text = c.Name or "Button", Font = Theme.Font, TextSize = 9, TextColor3 = Theme.Text, AutoButtonColor = false, LayoutOrder = nextOrder(), Parent = sec }, { Corner(3) })
				local st = Stroke(); st.Parent = b
				b.MouseEnter:Connect(function() Tween(b, { BackgroundColor3 = Theme.Element2 }) end)
				b.MouseLeave:Connect(function() Tween(b, { BackgroundColor3 = Theme.Element }) end)
				b.MouseButton1Click:Connect(function()
					st.Color = Theme.Accent
					Tween(st, { Color = Theme.Border }, 0.35)
					if c.Callback then task.spawn(c.Callback) end
				end)
				return { Button = b, SetText = function(_, t) b.Text = t end }
			end

			return Section
		end

		table.insert(Window.Tabs, Tab)
		if #Window.Tabs == 1 then Window:SelectTab(Tab) end
		return Tab
	end

	table.insert(NeverRage.Windows, Window)
	return Window
end

return NeverRage
