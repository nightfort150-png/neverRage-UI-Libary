NeverRage._onTheme = {}
local THEME_FILE = "NeverRage_Theme.txt"

local function findTheme(key)
	if type(key) ~= "string" then return nil end
	local k = string.lower((key:gsub("%s+", "")))
	for _, t in ipairs(NeverRage.Themes) do
		if string.lower(t.Name) == k or string.lower((t.Label:gsub("%s+", ""))) == k then return t end
	end
	return nil
end
local function loadSavedTheme()
	local name
	pcall(function()
		if isfile and readfile and isfile(THEME_FILE) then name = readfile(THEME_FILE) end
	end)
	if not name then pcall(function() if getgenv then name = getgenv().NeverRage_Theme end end) end
	return name
end
local function saveTheme(name)
	pcall(function() if writefile then writefile(THEME_FILE, name) end end)
	pcall(function() if getgenv then getgenv().NeverRage_Theme = name end end)
end

function NeverRage:GetThemeLabels()
	local out = {}
	for _, t in ipairs(self.Themes) do table.insert(out, t.Label) end
	return out
end
function NeverRage:OnThemeChanged(fn) table.insert(self._onTheme, fn) end

-- SetTheme("Aqua" | "Void" | "Crimson" | "Forest")  (the label, e.g. "Aqua / Blue", also works)
function NeverRage:SetTheme(key, noSave)
	local t = findTheme(key)
	if not t then return false end
	self.CurrentTheme = t
	self:SetAccent(t.Accent)
	for _, w in ipairs(self.Windows) do
		if w._applyBg then w._applyBg(t.Bg, true) end
	end
	for _, fn in ipairs(self._onTheme) do pcall(fn, t) end
	if not noSave then saveTheme(t.Name) end
	return true
end

-- load the saved theme (default: Crimson) before any window is built
NeverRage.CurrentTheme = findTheme(loadSavedTheme()) or findTheme("Crimson")
Theme.Accent = NeverRage.CurrentTheme.Accent

local function ser(v)
	local t = typeof(v)
	if t == "Color3" then return { __color = { v.R, v.G, v.B } } end
	if t == "table" then
		local a = {}
		for k, on in pairs(v) do if on then table.insert(a, k) end end
		table.sort(a)
		return { __multi = a }
	end
	if t == "EnumItem" then return v.Name end
	return v
end
local function deser(v)
	if type(v) == "table" then
		if v.__color then return Color3.new(v.__color[1], v.__color[2], v.__color[3]) end
		if v.__multi then
			local m = {}
			for _, k in ipairs(v.__multi) do m[k] = true end
			return m
		end
	end
	return v
end
function NeverRage:ExportConfig()
	local out = {}
	for k, v in pairs(self.Flags) do out[k] = ser(v) end
	return HttpService:JSONEncode(out)
end
function NeverRage:ImportConfig(json)
	local ok, data = pcall(function() return HttpService:JSONDecode(json) end)
	if not ok or type(data) ~= "table" then return false end
	for k, v in pairs(data) do
		local o = self.Objects[k]
		if o then pcall(function() o:Set(deser(v)) end) end
	end
	return true
end
function NeverRage:Notify(n)
	if self.Windows[1] then self.Windows[1]:Notify(n) end
end
function NeverRage:Unload()
	for i = #self.Windows, 1, -1 do self.Windows[i]:Destroy() end
end

-- ========================================================== window
function NeverRage:CreateWindow(cfg)
	cfg = cfg or {}
	if cfg.Accent then Theme.Accent = cfg.Accent end
	local W, H, TH, SW = 680, 430, 36, 122

	local Window = { Tabs = {}, Active = nil, ToggleKey = cfg.ToggleKey or Enum.KeyCode.RightShift, Loaded = (cfg.Loading == false) }
	local conns = {}
	local function conn(sig, fn) conns[#conns + 1] = sig:Connect(fn) end

	local gui = New("ScreenGui", { Name = "NeverRage_" .. (cfg.Id or "UI"), ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = true, DisplayOrder = 100 })
	Mount(gui)
	Window.Gui = gui

	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local baseScale = math.min(cfg.Scale or 1.3, vp.X * 0.94 / W, vp.Y * 0.94 / H)

	local main = New("Frame", {
		Name = "Main", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(W, H), BackgroundColor3 = Theme.Window, BorderSizePixel = 0, ClipsDescendants = true, Visible = false, Parent = gui,
	}, { Corner(4), Stroke(Theme.Border) })
	local uiScale = New("UIScale", { Scale = baseScale, Parent = main })

	-- theme background image (sits behind the semi-transparent panels)
	local bgImage = New("ImageLabel", {
		Name = "Background", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = NeverRage.CurrentTheme.Bg,
		ScaleType = Enum.ScaleType.Crop, ImageTransparency = 0.05, ZIndex = 0, Parent = main,
	})
	local function applyBg(id, animate)
		if animate and bgImage.Image ~= id then
			Tween(bgImage, { ImageTransparency = 1 }, 0.18)
			task.delay(0.2, function()
				if not bgImage.Parent then return end
				bgImage.Image = id
				Tween(bgImage, { ImageTransparency = 0.05 }, 0.25)
			end)
		else
			bgImage.Image = id
		end
	end
	Window._applyBg = applyBg

	-- rainbow bar
	local bar = New("Frame", { Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 10, Parent = main })
	New("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 70, 110)),
			ColorSequenceKeypoint.new(0.22, Color3.fromRGB(255, 190, 50)),
			ColorSequenceKeypoint.new(0.42, Color3.fromRGB(90, 235, 120)),
			ColorSequenceKeypoint.new(0.62, Color3.fromRGB(60, 190, 255)),
			ColorSequenceKeypoint.new(0.82, Color3.fromRGB(150, 90, 255)),
			ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 70, 200)),
		}),
		Parent = bar,
	})

	-- title bar
	local titlebar = New("Frame", { Size = UDim2.new(1, 0, 0, TH), BackgroundColor3 = Theme.Sidebar, BackgroundTransparency = 0.15, BorderSizePixel = 0, Parent = main })
	New("Frame", { Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, -1), BackgroundColor3 = Theme.Line, BorderSizePixel = 0, Parent = titlebar })

	local brand = New("Frame", { Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Position = UDim2.fromOffset(13, 1), BackgroundTransparency = 1, Parent = titlebar },
		{ New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 7), VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }) })
	local function titleText()
		return (cfg.Title or "Never") .. "<font color=\"" .. Hex(Theme.Accent) .. "\">" .. (cfg.TitleAccent or "Rage") .. "</font>"
	end
	local logo = Label({ Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, RichText = true, Text = titleText(), Font = Theme.FontBold, TextSize = 12, LayoutOrder = 0, Parent = brand })
	local tag = New("Frame", { Size = UDim2.new(0, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.XY, BackgroundColor3 = Theme.Element, BorderSizePixel = 0, LayoutOrder = 1, Parent = brand },
		{ Corner(3), Stroke(Theme.Border), Pad(5, 2, 5, 2) })
	Label({ Size = UDim2.new(0, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.XY, Text = cfg.Tag or "v1.0", TextSize = 7, TextColor3 = Theme.SubText, Parent = tag })

	-- window buttons
