			if scfg.Name then
				Label({ Size = UDim2.new(1, 0, 0, 12), Text = scfg.Name, TextSize = 8, TextColor3 = Theme.Dim, LayoutOrder = 0, Parent = sec })
			end

			local order, last = 0, nil
			local function nextOrder() order = order + 1; return order end
			local function spacer(kind)
				if last and last ~= kind then
					New("Frame", { Size = UDim2.new(1, 0, 0, 5), BackgroundTransparency = 1, LayoutOrder = nextOrder(), Parent = sec })
