	end

	-- ====================================================== tabs
	function Window:AddTab(tcfg)
		tcfg = tcfg or {}
		local Tab = {}
		tabOrder = tabOrder + 1

		local btn = New("TextButton", { Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, LayoutOrder = tabOrder, Parent = tabList })
		local ind = New("Frame", { Size = UDim2.fromOffset(3, 14), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Visible = false, Parent = btn }, { Corner(2) })
		local icon = BuildIcon(tcfg.Icon or "dots", btn, 12, Theme.SubText, 15, 7)
		local lbl = Label({ Size = UDim2.new(1, -52, 1, 0), Position = UDim2.fromOffset(35, 0), Text = tcfg.Name or "Tab", Font = Theme.FontMed, TextSize = 9, TextColor3 = Theme.SubText, Parent = btn })
		local chev = Glyph("right", btn, 6, Theme.Accent, SW - 19, 10)
		chev.Holder.Visible = false

		-- page
		local page = New("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false, ScrollBarThickness = 3,
			ScrollBarImageColor3 = Color3.fromRGB(60, 60, 70), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y, Parent = content,
		}, { Pad(28, 16, 30, 24), List(21) })

		local header = New("Frame", { Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, LayoutOrder = 0, Parent = page })
		local hbox = New("Frame", { Size = UDim2.fromOffset(26, 26), BackgroundColor3 = Theme.Element, BorderSizePixel = 0, Parent = header }, { Corner(4), Stroke() })
		local hicon = BuildIcon(tcfg.Icon or "dots", hbox, 14, Theme.Accent, 6, 6)
		Label({ Size = UDim2.new(1, -36, 0, 16), Position = UDim2.fromOffset(35, 0), Text = tcfg.Name or "Tab", Font = Theme.FontBold, TextSize = 13, Parent = header })
		Label({ Size = UDim2.new(1, -36, 0, 10), Position = UDim2.fromOffset(35, 16), Text = tcfg.Description or "", TextSize = 8, TextColor3 = Theme.SubText, Parent = header })
		OnAccent(function() hicon.SetColor(Theme.Accent) end)

		local cols = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 1, Parent = page },
			{ List(44, Enum.FillDirection.Horizontal) })
		local function column(o)
			return New("Frame", { Size = UDim2.new(0.5, -22, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = o, Parent = cols }, { List(18) })
		end
		local left, right = column(0), column(1)
		local colCount = { [left] = 0, [right] = 0 }

		function Tab:_render(on)
			local was = page.Visible
			page.Visible = on
			if on and not was then
				page.Position = UDim2.fromOffset(0, 8)
				Tween(page, { Position = UDim2.fromOffset(0, 0) }, 0.2)
				ind.Size = UDim2.fromOffset(3, 0)
				Tween(ind, { Size = UDim2.fromOffset(3, 14) }, 0.2)
			end
			ind.Visible = on
			chev.Holder.Visible = on
			ind.BackgroundColor3 = Theme.Accent
			chev.SetColor(Theme.Accent)
			Tween(btn, { BackgroundTransparency = on and 0.955 or 1 }, 0.15)
			Tween(lbl, { TextColor3 = on and Theme.Accent or Theme.SubText }, 0.15)
			icon.SetColor(on and Theme.Accent or Theme.SubText)
		end
		btn.MouseButton1Click:Connect(function() Window:SelectTab(Tab) end)
		btn.MouseEnter:Connect(function()
			if Window.Active ~= Tab then Tween(lbl, { TextColor3 = Theme.Text }, 0.12); icon.SetColor(Theme.Text) end
		end)
		btn.MouseLeave:Connect(function()
			if Window.Active ~= Tab then Tween(lbl, { TextColor3 = Theme.SubText }, 0.12); icon.SetColor(Theme.SubText) end
		end)

		-- ================================================== sections
		function Tab:AddSection(scfg)
			if type(scfg) == "string" then scfg = { Name = scfg } end
			scfg = scfg or {}
			local Section = {}
			local col = (scfg.Side == "Right") and right or left
			colCount[col] = colCount[col] + 1

			local sec = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = colCount[col], Parent = col }, { List(6) })
			if scfg.Name then
				Label({ Size = UDim2.new(1, 0, 0, 12), Text = scfg.Name, TextSize = 8, TextColor3 = Theme.Dim, LayoutOrder = 0, Parent = sec })
			end

			local order, last = 0, nil
			local function nextOrder() order = order + 1; return order end
			local function spacer(kind)
				if last and last ~= kind then
					New("Frame", { Size = UDim2.new(1, 0, 0, 5), BackgroundTransparency = 1, LayoutOrder = nextOrder(), Parent = sec })
				end
				last = kind
			end
			local function wrapper()
				return New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = nextOrder(), Parent = sec },
					{ New("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Right }) })
			end
			local function rowLabel(parent, text)
				return Label({ Size = UDim2.new(0.3, -4, 1, 0), Text = text or "", TextSize = 9, TextColor3 = Theme.MidText, TextTruncate = Enum.TextTruncate.AtEnd, Parent = parent })
			end

			-- ---------------------------------------------- label / separator
			function Section:AddLabel(text)
				spacer("label")
				local l = Label({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Text = text or "", TextWrapped = true, TextSize = 9, TextColor3 = Theme.SubText, LayoutOrder = nextOrder(), Parent = sec })
				return { Set = function(_, t) l.Text = t end, Get = function() return l.Text end }
			end
			function Section:AddSeparator()
				spacer("sep")
				New("Frame", { Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = Theme.Line, BorderSizePixel = 0, LayoutOrder = nextOrder(), Parent = sec })
			end

			-- ---------------------------------------------- toggle
			function Section:AddToggle(c)
				spacer("toggle")
				local value = c.Default and true or false
				local row = New("TextButton", { Size = UDim2.new(1, 0, 0, 13), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, LayoutOrder = nextOrder(), Parent = sec })
				local box = New("Frame", { Size = UDim2.fromOffset(10, 10), Position = UDim2.fromOffset(0, 1.5), BackgroundColor3 = Theme.Element, BorderSizePixel = 0, Parent = row }, { Corner(2.5) })
				local bstroke = Stroke(Theme.Border); bstroke.Parent = box
				local check = Glyph("check", box, 6, Color3.new(1, 1, 1), 2, 2)
				Label({ Size = UDim2.new(1, -17, 1, 0), Position = UDim2.fromOffset(17, 0), Text = c.Name or "Toggle", TextSize = 9, Parent = row })

				local obj = {}
				local function render()
					check.Holder.Visible = value
					Tween(box, { BackgroundColor3 = value and Theme.Accent or Theme.Element })
					bstroke.Color = value and Theme.Accent or Theme.Border
				end
				function obj:Set(v) value = v and true or false; render(); Fire(c.Flag, c.Callback, value) end
				function obj:Get() return value end
				row.MouseButton1Click:Connect(function() obj:Set(not value) end)
				Register(c.Flag, obj, value)
				OnAccent(render)
				render()
				return obj
			end

			-- ---------------------------------------------- slider
			function Section:AddSlider(c)
				spacer("slider")
				local min, max, inc = c.Min or 0, c.Max or 100, c.Increment or 1
				local suffix = c.Suffix or ""
				local decimals = 0
				local istr = tostring(inc)
				local dot = istr:find("%.")
				if dot then decimals = #istr - dot end
				local value = math.clamp(c.Default or min, min, max)

				local frame = New("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, LayoutOrder = nextOrder(), Parent = sec })
				Label({ Size = UDim2.new(0.65, 0, 0, 12), Text = c.Name or "Slider", TextSize = 9, TextColor3 = Theme.MidText, Parent = frame })
				local vlabel = Label({ Size = UDim2.new(0.35, 0, 0, 12), Position = UDim2.fromScale(0.65, 0), TextSize = 8, TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Right, Parent = frame })
				local track = New("Frame", { Size = UDim2.new(1, 0, 0, 3), Position = UDim2.fromOffset(0, 20), BackgroundColor3 = Theme.Track, BorderSizePixel = 0, Parent = frame }, { Corner(2) })
				local fill = New("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Parent = track }, { Corner(2) })
				local knob = New("Frame", { Size = UDim2.fromOffset(7, 7), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, ZIndex = 2, Parent = track }, { Corner(4) })

				local obj = {}
				local function render()
					local a = (max == min) and 0 or (value - min) / (max - min)
					fill.Size = UDim2.fromScale(a, 1)
					knob.Position = UDim2.fromScale(a, 0.5)
					fill.BackgroundColor3 = Theme.Accent
					knob.BackgroundColor3 = Theme.Accent
					vlabel.Text = string.format("%." .. decimals .. "f", value) .. suffix
				end
				function obj:Set(v)
					v = math.clamp(math.floor(v / inc + 0.5) * inc, min, max)
					value = tonumber(string.format("%.6f", v))
					render(); Fire(c.Flag, c.Callback, value)
				end
				function obj:Get() return value end

				local dragging = false
				local function fromX(x)
					local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
					obj:Set(min + (max - min) * a)
				end
				frame.InputBegan:Connect(function(i)
					if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
						dragging = true; fromX(i.Position.X)
					end
				end)
				conn(UIS.InputChanged, function(i)
					if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then fromX(i.Position.X) end
				end)
				conn(UIS.InputEnded, function(i)
					if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
				end)
				Register(c.Flag, obj, value)
				OnAccent(render)
				render()
				return obj
			end

			-- ---------------------------------------------- dropdown (single or multi)
			function Section:AddDropdown(c)
				spacer("dropdown")
				local multi = c.Multi and true or false
				local options = c.Options or {}
				local value
				if multi then
					value = {}
					for _, d in ipairs(c.Default or {}) do value[d] = true end
				else
					value = c.Default or options[1]
				end

				local wrap = wrapper()
				local row = New("Frame", { Size = UDim2.new(1, 0, 0, 19), BackgroundTransparency = 1, LayoutOrder = 0, Parent = wrap })
				rowLabel(row, c.Name or "Dropdown")
				local head = New("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0.693, 0, 1, 0), BackgroundColor3 = Theme.Element, Text = "", AutoButtonColor = false, Parent = row }, { Corner(3), Stroke() })
				local sel = Label({ Size = UDim2.new(1, -26, 1, 0), Position = UDim2.fromOffset(8, 0), TextSize = 9, TextTruncate = Enum.TextTruncate.AtEnd, Parent = head })
				local arrow = Glyph("down", head, 7, Theme.SubText, 0, 6)
				arrow.Holder.AnchorPoint = Vector2.new(0.5, 0.5)
				arrow.Holder.Position = UDim2.new(1, -12.5, 0.5, 0)

				local listFrame = New("Frame", { Size = UDim2.new(0.693, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Theme.Element, Visible = false, LayoutOrder = 1, Parent = wrap }, { Corner(3), Stroke(), List(0) })
				local obj = {}
				local open = false

				local function display()
					if multi then
						local names = {}
						for _, o in ipairs(options) do if value[o] then table.insert(names, tostring(o)) end end
						sel.Text = (#names > 0) and table.concat(names, ", ") or "None"
					else
						sel.Text = tostring(value)
					end
				end
				local function isOn(o) if multi then return value[o] == true end return value == o end
				local itemLabels = {}
				local function paint()
					for o, l in pairs(itemLabels) do l.TextColor3 = isOn(o) and Theme.Accent or Theme.SubText end
				end
				local function setOpen(v)
					open = v
					listFrame.Visible = v
					Tween(arrow.Holder, { Rotation = v and 180 or 0 }, 0.15)
				end
				function obj:Refresh(newOptions)
					options = newOptions or options
					for _, ch in ipairs(listFrame:GetChildren()) do if ch:IsA("TextButton") then ch:Destroy() end end
					itemLabels = {}
					if not multi and value ~= nil then
						local found = false
						for _, o in ipairs(options) do if o == value then found = true end end
						if not found then value = options[1] end
					end
					for idx, o in ipairs(options) do
						local b = New("TextButton", { Size = UDim2.new(1, 0, 0, 19), BackgroundColor3 = Theme.Element2, BackgroundTransparency = 1, Text = "", AutoButtonColor = false, LayoutOrder = idx, Parent = listFrame })
						itemLabels[o] = Label({ Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromOffset(8, 0), Text = tostring(o), TextSize = 9, TextColor3 = Theme.SubText, Parent = b })
						b.MouseEnter:Connect(function() b.BackgroundTransparency = 0.4 end)
						b.MouseLeave:Connect(function() b.BackgroundTransparency = 1 end)
						b.MouseButton1Click:Connect(function()
							if multi then
								value[o] = (not value[o]) or nil
								display(); paint(); Fire(c.Flag, c.Callback, value)
							else
								obj:Set(o); setOpen(false)
							end
						end)
					end
					display(); paint()
				end
				function obj:Set(v)
					if multi then
						local m = {}
						if type(v) == "table" then
							if v[1] ~= nil then for _, k in ipairs(v) do m[k] = true end
							else for k, on in pairs(v) do if on then m[k] = true end end end
						end
						value = m
					else
						value = v
					end
					display(); paint(); Fire(c.Flag, c.Callback, value)
				end
				function obj:Get() return value end
				head.MouseButton1Click:Connect(function() setOpen(not open) end)
				obj:Refresh(options)
				Register(c.Flag, obj, value)
				return obj
			end

			-- ---------------------------------------------- color picker (hue wheel + SV square)
			function Section:AddColorPicker(c)
				spacer("color")
				local color = c.Default or Color3.fromRGB(255, 255, 255)
				local h, s, v = color:ToHSV()

				local wrap = wrapper()
				local row = New("Frame", { Size = UDim2.new(1, 0, 0, 19), BackgroundTransparency = 1, LayoutOrder = 0, Parent = wrap })
				rowLabel(row, c.Name or "Color")
				local swatch = New("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(30, 13), BackgroundColor3 = color, Text = "", AutoButtonColor = false, Parent = row }, { Corner(3), Stroke() })
				local panel = New("Frame", { Size = UDim2.new(1, 0, 0, 134), BackgroundColor3 = Theme.Element, Visible = false, LayoutOrder = 1, Parent = wrap }, { Corner(4), Stroke() })

				local obj = {}
				local built = false
				local sq, sqBase, svCursor, hueMarker, preview, rgbLabels, hexBox
				local D, R = 112, 51

				local function apply(fire)
					color = Color3.fromHSV(h, s, v)
					swatch.BackgroundColor3 = color
					if built then
						sqBase.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
						svCursor.Position = UDim2.fromScale(s, 1 - v)
						local a = h * math.pi * 2
						hueMarker.Position = UDim2.fromOffset(D / 2 + math.cos(a) * R, D / 2 + math.sin(a) * R)
						preview.BackgroundColor3 = color
						rgbLabels[1].Text = "R   " .. math.floor(color.R * 255 + 0.5)
						rgbLabels[2].Text = "G   " .. math.floor(color.G * 255 + 0.5)
						rgbLabels[3].Text = "B   " .. math.floor(color.B * 255 + 0.5)
						hexBox.Text = Hex(color)
					end
					if fire then Fire(c.Flag, c.Callback, color) end
				end

				local function build()
					built = true
					local wheel = New("Frame", { Size = UDim2.fromOffset(D, D), Position = UDim2.fromOffset(10, 11), BackgroundTransparency = 1, Parent = panel })
					local N = 90
					for i = 0, N - 1 do
						local a = (i / N) * math.pi * 2
						New("Frame", {
							AnchorPoint = Vector2.new(0.5, 0.5),
							Position = UDim2.fromOffset(D / 2 + math.cos(a) * R, D / 2 + math.sin(a) * R),
							Size = UDim2.fromOffset(10, 5), Rotation = math.deg(a),
							BackgroundColor3 = Color3.fromHSV(i / N, 1, 1), BorderSizePixel = 0, Parent = wheel,
						})
					end
					sq = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(D / 2, D / 2), Size = UDim2.fromOffset(60, 60), BackgroundTransparency = 1, Parent = wheel })
					sqBase = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromHSV(h, 1, 1), BorderSizePixel = 0, Parent = sq }, { Corner(2) })
					local white = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = sqBase }, { Corner(2) })
					New("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = white })
					local black = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Parent = sqBase }, { Corner(2) })
					New("UIGradient", { Transparency = NumberSequence.new(1, 0), Rotation = 90, Parent = black })
					svCursor = New("Frame", { Size = UDim2.fromOffset(7, 7), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 3, Parent = sqBase }, { Corner(4), Stroke(Color3.new(1, 1, 1), 1.2) })
					hueMarker = New("Frame", { Size = UDim2.fromOffset(9, 9), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 3, Parent = wheel }, { Corner(5), Stroke(Color3.new(1, 1, 1), 1.4) })

					local cap = New("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 6, Parent = wheel })

					-- right side info
					preview = New("Frame", { Position = UDim2.fromOffset(134, 12), Size = UDim2.fromOffset(84, 22), BackgroundColor3 = color, BorderSizePixel = 0, Parent = panel }, { Corner(3), Stroke() })
					rgbLabels = {}
					for i = 1, 3 do
						rgbLabels[i] = Label({ Position = UDim2.fromOffset(136, 40 + (i - 1) * 16), Size = UDim2.fromOffset(80, 14), Text = "", TextSize = 9, TextColor3 = Theme.MidText, Parent = panel })
					end
					hexBox = New("TextBox", {
						Position = UDim2.fromOffset(134, 98), Size = UDim2.fromOffset(84, 22), BackgroundColor3 = Theme.Element2, BorderSizePixel = 0,
						Text = "", Font = Theme.Font, TextSize = 9, TextColor3 = Theme.Text, ClearTextOnFocus = false, Parent = panel,
					}, { Corner(3), Stroke() })
					hexBox.FocusLost:Connect(function()
						local t = hexBox.Text:gsub("#", "")
						if #t == 6 and t:match("^%x%x%x%x%x%x$") then
							local nc = Color3.fromRGB(tonumber(t:sub(1, 2), 16), tonumber(t:sub(3, 4), 16), tonumber(t:sub(5, 6), 16))
							h, s, v = nc:ToHSV()
						end
						apply(true)
					end)

					-- interaction
					local mode
					local function update(pos)
						local p = Vector2.new(pos.X, pos.Y)
						if mode == "hue" then
							local vec = p - (wheel.AbsolutePosition + wheel.AbsoluteSize / 2)
							h = ((math.atan2(vec.Y, vec.X) / (math.pi * 2)) + 1) % 1
						elseif mode == "sv" then
							local rel = (p - sq.AbsolutePosition) / sq.AbsoluteSize
							s = math.clamp(rel.X, 0, 1)
							v = 1 - math.clamp(rel.Y, 0, 1)
						end
						apply(true)
					end
					cap.InputBegan:Connect(function(i)
						if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
							local p = Vector2.new(i.Position.X, i.Position.Y)
							local rel = (p - sq.AbsolutePosition) / sq.AbsoluteSize
							local r = (p - (wheel.AbsolutePosition + wheel.AbsoluteSize / 2)).Magnitude / (wheel.AbsoluteSize.X / 2)
							if rel.X >= 0 and rel.X <= 1 and rel.Y >= 0 and rel.Y <= 1 then mode = "sv"
							elseif r > 0.62 and r <= 1.12 then mode = "hue"
							else mode = nil end
							if mode then update(i.Position) end
						end
					end)
					conn(UIS.InputChanged, function(i)
						if mode and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then update(i.Position) end
					end)
					conn(UIS.InputEnded, function(i)
						if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then mode = nil end
					end)
					apply(false)
				end

				swatch.MouseButton1Click:Connect(function()
					panel.Visible = not panel.Visible
					if panel.Visible and not built then build() end
				end)
				function obj:Set(nc)
					if typeof(nc) == "table" and nc.__color then nc = Color3.new(nc.__color[1], nc.__color[2], nc.__color[3]) end
					if typeof(nc) ~= "Color3" then return end
					h, s, v = nc:ToHSV()
					apply(true)
				end
				function obj:Get() return color end
				Register(c.Flag, obj, color)
				return obj
			end

			-- ---------------------------------------------- keybind
			function Section:AddKeybind(c)
				spacer("keybind")
				local key = c.Default
				if type(key) == "string" then key = Enum.KeyCode[key] end
				local listening = false

				local row = New("Frame", { Size = UDim2.new(1, 0, 0, 19), BackgroundTransparency = 1, LayoutOrder = nextOrder(), Parent = sec })
				rowLabel(row, c.Name or "Keybind")
				local box = New("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0.34, 0, 1, 0), BackgroundColor3 = Theme.Element, Text = "", AutoButtonColor = false, Parent = row }, { Corner(3), Stroke() })
				local txt = Label({ Size = UDim2.fromScale(1, 1), Text = "", TextSize = 9, TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd, Parent = box })

				local obj = {}
				local function render()
					txt.Text = listening and "..." or (key and key.Name or "None")
					txt.TextColor3 = listening and Theme.Accent or Theme.SubText
				end
				function obj:Set(k)
					if type(k) == "string" then k = (k ~= "None") and Enum.KeyCode[k] or nil end
					key = k
					render()
					Fire(c.Flag, nil, key and key.Name or "None")
					if c.Changed then task.spawn(c.Changed, key) end
				end
				function obj:Get() return key end
				box.MouseButton1Click:Connect(function()
					listening = true
					NeverRage._listening = true
					render()
				end)
				conn(UIS.InputBegan, function(i, gp)
					if listening then
						if i.UserInputType == Enum.UserInputType.Keyboard then
							listening = false
							task.delay(0.1, function() NeverRage._listening = false end)
							if i.KeyCode == Enum.KeyCode.Escape then obj:Set(nil) else obj:Set(i.KeyCode) end
						end
					elseif key and not gp and i.KeyCode == key and c.Callback then
						task.spawn(c.Callback, key)
					end
				end)
				Register(c.Flag, obj, key and key.Name or "None")
				render()
				return obj
			end

			-- ---------------------------------------------- textbox
			function Section:AddTextBox(c)
				spacer("textbox")
				local value = c.Default or ""
				local row = New("Frame", { Size = UDim2.new(1, 0, 0, 19), BackgroundTransparency = 1, LayoutOrder = nextOrder(), Parent = sec })
				rowLabel(row, c.Name or "Text")
				local tb = New("TextBox", {
					AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0.693, 0, 1, 0),
					BackgroundColor3 = Theme.Element, BorderSizePixel = 0, Text = value, PlaceholderText = c.Placeholder or "", PlaceholderColor3 = Theme.Dim,
					Font = Theme.Font, TextSize = 9, TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, Parent = row,
				}, { Corner(3), Stroke(), Pad(8, 0, 8, 0) })
				local obj = {}
				function obj:Set(t) value = tostring(t); tb.Text = value; Fire(c.Flag, c.Callback, value) end
				function obj:Get() return value end
				tb.FocusLost:Connect(function() value = tb.Text; Fire(c.Flag, c.Callback, value) end)
				Register(c.Flag, obj, value)
				return obj
			end

			-- ---------------------------------------------- button
			function Section:AddButton(c)
				spacer("button")
				local b = New("TextButton", { Size = UDim2.new(1, 0, 0, 21), BackgroundColor3 = Theme.Element, Text = c.Name or "Button", Font = Theme.Font, TextSize = 9, TextColor3 = Theme.Text, AutoButtonColor = false, LayoutOrder = nextOrder(), Parent = sec }, { Corner(3) })
				local st = Stroke(); st.Parent = b
				b.MouseEnter:Connect(function() Tween(b, { BackgroundColor3 = Theme.Element2 }) end)
				b.MouseLeave:Connect(function() Tween(b, { BackgroundColor3 = Theme.Element }) end)
				b.MouseButton1Click:Connect(function()
					st.Color = Theme.Accent
					Tween(st, { Color = Theme.Border }, 0.35)
					if c.Callback then task.spawn(c.Callback) end
				end)
				return { Button = b, SetText = function(_, t) b.Text = t end }
			end

			return Section
		end

		table.insert(Window.Tabs, Tab)
		if #Window.Tabs == 1 then Window:SelectTab(Tab) end
		return Tab
	end

	table.insert(NeverRage.Windows, Window)
	return Window
end

-- ========================================================== selector (launch menu)
function NeverRage:CreateSelector(cfg)
	cfg = cfg or {}
	local options = cfg.Options or {}
	local n = #options
	local index = math.clamp(cfg.Default or 1, 1, math.max(n, 1))
	local closing = false
	local token = 0
	local conns = {}
	local logoId = cfg.Logo or "rbxassetid://127179358842282"

	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local sc = math.min(1.25, vp.X * 0.86 / 560, vp.Y * 0.9 / 300)
	local function u(x) return math.floor(x * sc + 0.5) end

	local gui = New("ScreenGui", { Name = "NeverRage_Selector", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = true, DisplayOrder = 200 })
	Mount(gui)

	-- darkened background (also blocks clicks to the game behind it)
	local dim = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0, Active = true, Parent = gui })
	Tween(dim, { BackgroundTransparency = 0.35 }, 0.35)

	local groups = {}
	local function titleText()
		return (cfg.Title or "Never") .. "<font color=\"" .. Hex(Theme.Accent) .. "\">" .. (cfg.TitleAccent or "Rage") .. "</font>"
	end

	local center = New("CanvasGroup", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(math.max(u(560), n * u(240) + u(80)), u(300)), BackgroundTransparency = 1, GroupTransparency = 1, Parent = dim,
	})
	groups[#groups + 1] = center
	local title = Label({ Size = UDim2.new(1, 0, 0, u(22)), Position = UDim2.fromOffset(0, u(6)), RichText = true, Text = titleText(), Font = Theme.FontBold, TextSize = u(17), TextXAlignment = Enum.TextXAlignment.Center, Parent = center })
	Label({ Size = UDim2.new(1, 0, 0, u(14)), Position = UDim2.fromOffset(0, u(30)), Text = cfg.Subtitle or "Select an option", TextSize = u(9), TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Center, Parent = center })
	local hint = "Select an option, then press Launch"
	local status = Label({ Size = UDim2.new(1, 0, 0, u(14)), Position = UDim2.fromOffset(0, u(272)), Text = hint, TextSize = u(9), TextColor3 = Theme.Dim, TextXAlignment = Enum.TextXAlignment.Center, Parent = center })

	local function setStatus(text)
		token = token + 1
		local my = token
		status.Text = text
		status.TextColor3 = Theme.Accent
		task.delay(1.8, function()
			if my == token and status.Parent then status.Text = hint; status.TextColor3 = Theme.Dim end
		end)
	end

	local cards = {}
	local lglyph, rglyph

	local function refresh()
		local info = TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		for i, c in ipairs(cards) do
			local on = (i == index)
			TweenService:Create(c.scale, info, { Scale = on and 1.18 or 0.88 }):Play()
			Tween(c.img, { ImageTransparency = on and 0 or 0.55 }, 0.22)
			Tween(c.label, { TextColor3 = on and Theme.Accent or Theme.SubText }, 0.22)
			Tween(c.bar, { Size = UDim2.fromOffset(on and u(26) or 0, u(2)), BackgroundColor3 = Theme.Accent }, 0.22)
		end
		if lglyph then lglyph.SetColor(index > 1 and Theme.Text or Theme.Dim) end
		if rglyph then rglyph.SetColor(index < n and Theme.Text or Theme.Dim) end
	end

	local function select(i)
		if closing or n == 0 then return end
		i = math.clamp(i, 1, n)
		if i == index then return end
		index = i
		refresh()
	end

	-- plain close (no loading sequence)
	local function close()
		if closing then return end
		closing = true
		for _, c in ipairs(conns) do c:Disconnect() end
		Tween(dim, { BackgroundTransparency = 1 }, 0.3)
		for _, g in ipairs(groups) do Tween(g, { GroupTransparency = 1 }, 0.25) end
		task.delay(0.32, function() gui:Destroy() end)
	end

	-- ------------------------------------------------ loading sequence + pixel shatter
	local function runLoading(o)
		local total = cfg.LoadTime or 6
		local panelFrac = 0.4
		local red = cfg.PanelColor or NeverRage.CurrentTheme.Panel
		local bg = Color3.fromRGB(10, 10, 13)
		local gradEnd = Color3.new(0, 0, 0)

		-- selector fades out, screen goes dark
		dim.BackgroundColor3 = bg
		Tween(dim, { BackgroundTransparency = 0 }, 0.4)
		for _, g in ipairs(groups) do Tween(g, { GroupTransparency = 1 }, 0.25) end
		task.wait(0.45)
		for _, g in ipairs(groups) do g.Visible = false end

		-- red side panel
		local panel = New("Frame", { Size = UDim2.new(panelFrac, 0, 1, 0), Position = UDim2.new(-panelFrac, 0, 0, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = dim })
		New("UIGradient", { Rotation = 90, Color = ColorSequence.new(red, red:Lerp(gradEnd, 0.35)), Parent = panel })
		New("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, 3, 1, 0), BackgroundColor3 = red:Lerp(Color3.new(1, 1, 1), 0.25), BorderSizePixel = 0, Parent = panel })

		local lc = New("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = panel })
		local inner = New("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, u(34), 0.5, 0), Size = UDim2.new(1, -u(64), 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = lc }, { List(u(12)) })
		New("ImageLabel", { Size = UDim2.fromOffset(u(72), u(72)), BackgroundTransparency = 1, Image = logoId, ScaleType = Enum.ScaleType.Fit, LayoutOrder = 0, Parent = inner })
		Label({ Size = UDim2.new(1, 0, 0, u(34)), RichText = true, Text = (cfg.Title or "Never") .. "<font color=\"#FFD2DA\">" .. (cfg.TitleAccent or "Rage") .. "</font>", Font = Theme.FontBold, TextSize = u(30), LayoutOrder = 1, Parent = inner })
		New("Frame", { Size = UDim2.fromOffset(u(36), u(3)), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.2, BorderSizePixel = 0, LayoutOrder = 2, Parent = inner }, { Corner(2) })
		Label({
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 3,
			Text = cfg.Description or "NeverRage is a lightweight, customizable UI library and script hub for Roblox. Clean menus, smooth animations and powerful controls, built to be simple to use and easy to extend.",
			TextSize = u(11), TextColor3 = Color3.fromRGB(255, 232, 236), Parent = inner,
		})

		-- right side: Loading + rotating messages
		local rc = New("CanvasGroup", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(panelFrac + (1 - panelFrac) / 2, 0, 0.5, 0), Size = UDim2.fromOffset(u(440), u(130)), BackgroundTransparency = 1, GroupTransparency = 1, Parent = dim })
		local row = New("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, u(14)), Size = UDim2.new(0, 0, 0, u(34)), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, Parent = rc },
			{ New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, u(1)), SortOrder = Enum.SortOrder.LayoutOrder }) })
		Label({ Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Text = "Loading", Font = Theme.FontBold, TextSize = u(26), LayoutOrder = 0, Parent = row })
		local dots = {}
		for d = 1, 3 do
			dots[d] = Label({ Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Text = ".", Font = Theme.FontBold, TextSize = u(26), TextTransparency = 0.85, LayoutOrder = d, Parent = row })
		end
		local msgLabel = Label({
			Size = UDim2.new(1, 0, 0, u(44)), Position = UDim2.fromOffset(0, u(64)), TextWrapped = true, Text = "", TextSize = u(12),
			TextColor3 = Color3.fromRGB(175, 175, 186), TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top, TextTransparency = 1, Parent = rc,
		})

		Tween(panel, { Position = UDim2.fromScale(0, 0) }, 0.6)
		task.wait(0.4)
		Tween(rc, { GroupTransparency = 0 }, 0.4)

		local alive = true
		task.spawn(function()
			local k = 0
			while alive and gui.Parent do
				k = (k + 1) % 4
				for d = 1, 3 do Tween(dots[d], { TextTransparency = (d <= k) and 0 or 0.85 }, 0.12) end
				task.wait(0.35)
			end
		end)

		local msgs = cfg.Messages or {
			"Believe in the process. Every great build starts small.",
			"Thank you for supporting NeverRage. It means a lot.",
			"Stay curious. Keep creating.",
			"Small steps every day lead to big results.",
			"You've got this. Almost there.",
			"Your support keeps NeverRage getting better.",
		}
		local count = math.max(2, math.floor(total / 2.1 + 0.5))
		local startAt = math.random(1, #msgs)
		for m = 1, count do
			msgLabel.Text = msgs[(startAt + m - 2) % #msgs + 1]
			Tween(msgLabel, { TextTransparency = 0 }, 0.35)
			task.wait(1.35)
			Tween(msgLabel, { TextTransparency = 1 }, 0.35)
			task.wait(0.4)
		end
		alive = false

		-- content fades, then the whole screen shatters into pixels
		Tween(rc, { GroupTransparency = 1 }, 0.2)
		Tween(lc, { GroupTransparency = 1 }, 0.2)
		task.wait(0.25)

		local v = gui.AbsoluteSize
		if v.X < 100 or v.Y < 100 then v = vp end
		local cs = math.max(30, math.floor(v.X / 26))
		local cols, rows = math.ceil(v.X / cs), math.ceil(v.Y / cs)
		local panelW = v.X * panelFrac
		local shards = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 10, Parent = gui })
		local pending = {}
		for gx = 0, cols - 1 do
			for gy = 0, rows - 1 do
				local px, py = gx * cs + cs / 2, gy * cs + cs / 2
				local base
				if px < panelW then base = red:Lerp(gradEnd, 0.35 * (py / v.Y)) else base = bg end
				local j = (math.random() - 0.5) * 0.06
				local col = Color3.new(math.clamp(base.R + j, 0, 1), math.clamp(base.G + j, 0, 1), math.clamp(base.B + j, 0, 1))
				local f = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(px, py), Size = UDim2.fromOffset(cs + 1, cs + 1), BackgroundColor3 = col, BorderSizePixel = 0, Parent = shards })
				pending[#pending + 1] = { f = f, px = px, py = py }
			end
		end
		-- shards now cover the screen, so swap out the real panels instantly
		panel.Visible = false
		rc.Visible = false
		dim.BackgroundTransparency = 1

		-- load whatever was selected while the pixels fall away
		task.spawn(function()
			local ok, err = pcall(o.Callback, o)
			if not ok then warn("[NeverRage] selector callback error: " .. tostring(err)) end
		end)

		for _, sh in ipairs(pending) do
			local dx = (math.random() - 0.5) * cs * 3 + (sh.px - v.X / 2) * 0.12
			local dy = cs * (1.5 + math.random() * 5)
			local rot = (math.random() - 0.5) * 360
			local dur = 0.7 + math.random() * 0.6
			local delay = (sh.px / v.X) * 0.45 + math.random() * 0.15
			task.delay(delay, function()
				if not sh.f.Parent then return end
				TweenService:Create(sh.f, TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
					Position = UDim2.fromOffset(sh.px + dx, sh.py + dy), Rotation = rot, BackgroundTransparency = 1,
					Size = UDim2.fromOffset(cs * 0.35, cs * 0.35),
				}):Play()
			end)
		end
		task.wait(2.2)
		gui:Destroy()
	end

	local function launch()
		if closing or n == 0 then return end
		local o = options[index]
		if not o then return end
		if not o.Callback then setStatus(o.Message or "Coming soon") return end
		closing = true
		for _, c in ipairs(conns) do c:Disconnect() end
		task.spawn(function()
			local ok, err = pcall(runLoading, o)
			if not ok then
				warn("[NeverRage] launch sequence error: " .. tostring(err))
				if gui.Parent then gui:Destroy() end
				pcall(o.Callback, o)
			end
		end)
	end

	-- icon cards (no background square, just the icon + name)
	for i, o in ipairs(options) do
		local x = (i - (n + 1) / 2) * u(240)
		local card = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, x, 0, u(128)), Size = UDim2.fromOffset(u(150), u(136)), BackgroundTransparency = 1, Parent = center })
		local cscale = New("UIScale", { Scale = 0.6, Parent = card })
		local img = New("ImageLabel", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.fromOffset(u(104), u(104)), BackgroundTransparency = 1, Image = o.Icon or "", ImageTransparency = 0.55, ScaleType = Enum.ScaleType.Fit, Parent = card })
		local lbl = Label({ Size = UDim2.new(1, 0, 0, u(18)), Position = UDim2.fromOffset(0, u(108)), Text = o.Name or ("Option " .. i), Font = Theme.FontBold, TextSize = u(13), TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Center, Parent = card })
		local bar = New("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, u(130)), Size = UDim2.fromOffset(0, u(2)), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Parent = card }, { Corner(1) })
		local hit = New("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 5, Parent = card })
		hit.MouseEnter:Connect(function() select(i) end)
		hit.MouseButton1Click:Connect(function() select(i) end)
		cards[i] = { scale = cscale, img = img, label = lbl, bar = bar }
	end

	-- launch button
	local launchBtn = New("TextButton", {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, u(228)), Size = UDim2.fromOffset(u(150), u(34)),
		BackgroundColor3 = Theme.Accent, Text = "Launch", Font = Theme.FontBold, TextSize = u(13), TextColor3 = Color3.new(1, 1, 1), AutoButtonColor = false, Parent = center,
	}, { Corner(u(17)) })
	local lscale = New("UIScale", { Scale = 1, Parent = launchBtn })
	launchBtn.MouseEnter:Connect(function() Tween(launchBtn, { BackgroundColor3 = Theme.Accent:Lerp(Color3.new(1, 1, 1), 0.15) }) end)
	launchBtn.MouseLeave:Connect(function() Tween(launchBtn, { BackgroundColor3 = Theme.Accent }); Tween(lscale, { Scale = 1 }, 0.1) end)
	launchBtn.MouseButton1Down:Connect(function() Tween(lscale, { Scale = 0.95 }, 0.08) end)
	launchBtn.MouseButton1Up:Connect(function() Tween(lscale, { Scale = 1 }, 0.1) end)
	launchBtn.MouseButton1Click:Connect(launch)

	-- side arrows
	local function arrow(side)
		local wrap = New("CanvasGroup", {
			AnchorPoint = Vector2.new(side == "left" and 0 or 1, 0.5),
			Position = UDim2.new(side == "left" and 0 or 1, side == "left" and u(22) or -u(22), 0.5, 0),
			Size = UDim2.fromOffset(u(44), u(44)), BackgroundColor3 = Theme.Element, BackgroundTransparency = 0.15, BorderSizePixel = 0, GroupTransparency = 1, Parent = dim,
		}, { Corner(u(22)) })
		local st = Stroke(Theme.Border, 1.2); st.Parent = wrap
		local g = Glyph(side, wrap, u(14), Theme.Text, u(15), u(15))
		local b = New("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 5, Parent = wrap })
		b.MouseEnter:Connect(function() Tween(st, { Color = Theme.Accent }) end)
		b.MouseLeave:Connect(function() Tween(st, { Color = Theme.Border }) end)
		groups[#groups + 1] = wrap
		return b, g
	end
	local lb, rb
	lb, lglyph = arrow("left")
	rb, rglyph = arrow("right")
	lb.MouseButton1Click:Connect(function() select(index - 1) end)
	rb.MouseButton1Click:Connect(function() select(index + 1) end)

	-- keyboard
	conns[#conns + 1] = UIS.InputBegan:Connect(function(i)
		if i.KeyCode == Enum.KeyCode.Left or i.KeyCode == Enum.KeyCode.A then select(index - 1)
		elseif i.KeyCode == Enum.KeyCode.Right or i.KeyCode == Enum.KeyCode.D then select(index + 1)
		elseif i.KeyCode == Enum.KeyCode.Return or i.KeyCode == Enum.KeyCode.KeypadEnter then launch() end
	end)

	OnAccent(function()
		if title.Parent then
			title.Text = titleText()
			launchBtn.BackgroundColor3 = Theme.Accent
			refresh()
		end
	end)

	for _, g in ipairs(groups) do Tween(g, { GroupTransparency = 0 }, 0.35) end
	refresh()

	return { Gui = gui, Select = select, Launch = launch, Close = close }
end

-- ========================================================== universal loader window
function NeverRage:CreateLoader(cfg)
	cfg = cfg or {}
	local W, H, TH = 360, 300, 34
	local games = {}
	for _, g in ipairs(cfg.Games or {}) do table.insert(games, g) end
	local Loader = {}
	local conns = {}
	local function conn(sig, fn) conns[#conns + 1] = sig:Connect(fn) end
	local logoId = cfg.Logo or "rbxassetid://127179358842282"
	local red = cfg.Red or NeverRage.CurrentTheme.Panel
	local dimCol, lightCol = Color3.fromRGB(150, 150, 160), Color3.fromRGB(255, 170, 184)

	local gui = New("ScreenGui", { Name = "NeverRage_Loader", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = true, DisplayOrder = 100 })
	Mount(gui)

	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local scale = math.min(cfg.Scale or 1.3, vp.X * 0.92 / W, vp.Y * 0.92 / H)

	local main = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(W, H),
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ClipsDescendants = true, Parent = gui,
	}, { Corner(8) })
	local mstroke = Stroke(red:Lerp(Color3.new(0, 0, 0), 0.4), 1.5); mstroke.Parent = main
	local uiScale = New("UIScale", { Scale = scale * 0.92, Parent = main })
	Tween(uiScale, { Scale = scale }, 0.22)
	-- themed color-to-black gradient background (red by default)
	local grad = New("UIGradient", { Rotation = 115, Parent = main })
	local function applyGrad()
		grad.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, red:Lerp(Color3.new(0, 0, 0), 0.05)),
			ColorSequenceKeypoint.new(0.5, red:Lerp(Color3.new(0, 0, 0), 0.77)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(8, 8, 10)),
		})
	end
	applyGrad()

	-- title bar
	local titlebar = New("Frame", { Size = UDim2.new(1, 0, 0, TH), BackgroundTransparency = 1, Parent = main })
	New("Frame", { Size = UDim2.new(1, 0, 0, 1), Position = UDim2.new(0, 0, 1, -1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.6, BorderSizePixel = 0, Parent = titlebar })
	New("ImageLabel", { Size = UDim2.fromOffset(20, 20), Position = UDim2.fromOffset(12, 7), BackgroundTransparency = 1, Image = logoId, ScaleType = Enum.ScaleType.Fit, Parent = titlebar })
	Label({ Size = UDim2.new(1, -110, 1, 0), Position = UDim2.fromOffset(38, 0), RichText = true, Text = "Never<font color=\"#FF9FB0\">Rage</font> Uni Loader", Font = Theme.FontBold, TextSize = 12, Parent = titlebar })

	local body = New("Frame", { Size = UDim2.new(1, 0, 1, -TH), Position = UDim2.fromOffset(0, TH), BackgroundTransparency = 1, Parent = main })
	local collapsed = false

	local btns = New("Frame", { Size = UDim2.fromOffset(64, TH), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -4, 0, 0), BackgroundTransparency = 1, Parent = titlebar },
		{ New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder }) })
	local function winButton(kind, order, hover, fn)
		local b = New("TextButton", { Size = UDim2.fromOffset(32, TH), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, LayoutOrder = order, Parent = btns })
		local g = Glyph(kind, b, 9, Color3.fromRGB(230, 200, 206), 11.5, 12.5)
		b.MouseEnter:Connect(function() g.SetColor(hover) end)
		b.MouseLeave:Connect(function() g.SetColor(Color3.fromRGB(230, 200, 206)) end)
		b.MouseButton1Click:Connect(fn)
	end
	winButton("minimize", 0, Color3.new(1, 1, 1), function()
		collapsed = not collapsed
		if collapsed then
			body.Visible = false
			Tween(main, { Size = UDim2.fromOffset(W, TH) }, 0.16)
		else
			Tween(main, { Size = UDim2.fromOffset(W, H) }, 0.16)
			task.delay(0.12, function() if not collapsed then body.Visible = true end end)
		end
	end)
	winButton("close", 1, Color3.fromRGB(255, 120, 140), function() Loader:Destroy() end)

	-- dragging
	do
		local dragging, start, startPos
		titlebar.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				dragging, start, startPos = true, i.Position, main.Position
			end
		end)
		conn(UIS.InputChanged, function(i)
			if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
				local d = i.Position - start
				main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			end
		end)
		conn(UIS.InputEnded, function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
		end)
	end

	-- ---------------------------------------------- 3D search bar
	local barH = 34
	New("Frame", { Position = UDim2.fromOffset(14, 16), Size = UDim2.new(1, -28, 0, barH), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, BorderSizePixel = 0, Parent = body }, { Corner(11) })
	local rim = New("Frame", { Position = UDim2.fromOffset(14, 12), Size = UDim2.new(1, -28, 0, barH), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = body }, { Corner(11) })
	New("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(10, 10, 12), Color3.fromRGB(128, 100, 108)), Parent = rim })
	local rimStroke = Stroke(Color3.fromRGB(30, 6, 10), 1); rimStroke.Parent = rim
	local field = New("Frame", { Position = UDim2.fromOffset(2, 2), Size = UDim2.new(1, -4, 1, -5), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = rim }, { Corner(9) })
	New("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(11, 11, 14), Color3.fromRGB(30, 28, 36)), Parent = field })
	local innerShadow = New("Frame", { Size = UDim2.new(1, 0, 0, 9), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Parent = field }, { Corner(5) })
	New("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(0.3, 1), Parent = innerShadow })

	local mag = New("Frame", { Size = UDim2.fromOffset(16, 16), Position = UDim2.new(0, 11, 0.5, -8), BackgroundTransparency = 1, Parent = field })
	local ring = New("Frame", { Size = UDim2.fromOffset(10, 10), Position = UDim2.fromOffset(1, 1), BackgroundTransparency = 1, Parent = mag }, { Corner(5) })
	local ringStroke = New("UIStroke", { Color = dimCol, Thickness = 1.6, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = ring })
	local handle = Seg(mag, 9.6, 9.6, 14, 14, 1.8, dimCol)

	local box = New("TextBox", {
		Position = UDim2.fromOffset(34, 0), Size = UDim2.new(1, -62, 1, 0), BackgroundTransparency = 1, Text = "", PlaceholderText = "Search games...",
		PlaceholderColor3 = Color3.fromRGB(110, 110, 120), Font = Theme.Font, TextSize = 11, TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
		ClearTextOnFocus = false, Parent = field,
	})
	local clearBtn = New("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), Size = UDim2.fromOffset(22, 22), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Visible = false, Parent = field })
	local cg = Glyph("close", clearBtn, 7, dimCol, 7.5, 7.5)
	clearBtn.MouseEnter:Connect(function() cg.SetColor(Color3.new(1, 1, 1)) end)
	clearBtn.MouseLeave:Connect(function() cg.SetColor(dimCol) end)
	clearBtn.MouseButton1Click:Connect(function() box.Text = "" end)
	box.Focused:Connect(function()
		Tween(rimStroke, { Color = red }, 0.15)
		ringStroke.Color = lightCol; handle.BackgroundColor3 = lightCol
	end)
	box.FocusLost:Connect(function()
		Tween(rimStroke, { Color = Color3.fromRGB(30, 6, 10) }, 0.15)
		ringStroke.Color = dimCol; handle.BackgroundColor3 = dimCol
	end)

	-- ---------------------------------------------- list / empty state
	Label({ Size = UDim2.new(0.6, 0, 0, 12), Position = UDim2.fromOffset(16, 60), Text = "AVAILABLE GAMES", Font = Theme.FontBold, TextSize = 8, TextColor3 = Color3.fromRGB(255, 190, 200), Parent = body })
	local countLabel = Label({ Size = UDim2.new(0.4, -16, 0, 12), Position = UDim2.new(0.6, 0, 0, 60), Text = "", TextSize = 8, TextColor3 = Color3.fromRGB(230, 170, 180), TextXAlignment = Enum.TextXAlignment.Right, Parent = body })

	local list = New("ScrollingFrame", {
		Position = UDim2.fromOffset(14, 78), Size = UDim2.new(1, -28, 1, -108), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
		ScrollBarImageColor3 = Color3.fromRGB(255, 120, 140), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = body,
	}, { List(6) })

	local empty = New("Frame", { Position = UDim2.fromOffset(14, 78), Size = UDim2.new(1, -28, 1, -108), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.6, BorderSizePixel = 0, Parent = body }, { Corner(8) })
	local est = Stroke(Color3.new(1, 1, 1), 1); est.Transparency = 0.88; est.Parent = empty
	local emptyTitle = Label({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, -10), Size = UDim2.new(1, -20, 0, 18), Text = "", Font = Theme.FontBold, TextSize = 13, TextColor3 = Color3.fromRGB(255, 214, 220), TextXAlignment = Enum.TextXAlignment.Center, Parent = empty })
	local emptySub = Label({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 14), Size = UDim2.new(1, -30, 0, 28), Text = "", TextSize = 9, TextColor3 = Color3.fromRGB(190, 150, 158), TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top, Parent = empty })

	Label({ Size = UDim2.new(1, -28, 0, 14), AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 16, 1, -8), Text = cfg.Footer or "NeverRage Universal Loader", TextSize = 8, TextColor3 = Color3.fromRGB(200, 150, 160), Parent = body })

	local function refresh()
		local q = string.lower(box.Text or "")
		for _, ch in ipairs(list:GetChildren()) do
			if ch:IsA("Frame") then ch:Destroy() end
		end
		local shown = 0
		for i, g in ipairs(games) do
			if q == "" or string.find(string.lower(g.Name or ""), q, 1, true) then
				shown = shown + 1
				local row = New("Frame", { Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.4, BorderSizePixel = 0, LayoutOrder = i, Parent = list }, { Corner(7) })
				local rst = Stroke(Color3.new(1, 1, 1), 1); rst.Transparency = 0.9; rst.Parent = row
				New("ImageLabel", { Size = UDim2.fromOffset(30, 30), Position = UDim2.fromOffset(8, 8), BackgroundTransparency = 1, Image = g.Icon or logoId, ScaleType = Enum.ScaleType.Fit, Parent = row }, { Corner(6) })
				Label({ Size = UDim2.new(1, -130, 0, 14), Position = UDim2.fromOffset(46, 8), Text = g.Name or "Game", Font = Theme.FontBold, TextSize = 11, TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
				Label({ Size = UDim2.new(1, -130, 0, 12), Position = UDim2.fromOffset(46, 24), Text = g.Description or (g.PlaceId and ("Place " .. tostring(g.PlaceId)) or "Universal"), TextSize = 8, TextColor3 = Color3.fromRGB(215, 170, 178), TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
				local lb = New("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(62, 24), BackgroundColor3 = red, Text = "Load", Font = Theme.FontBold, TextSize = 10, TextColor3 = Color3.new(1, 1, 1), AutoButtonColor = false, Parent = row }, { Corner(12) })
				lb.MouseEnter:Connect(function() Tween(lb, { BackgroundColor3 = red:Lerp(Color3.new(1, 1, 1), 0.18) }) end)
				lb.MouseLeave:Connect(function() Tween(lb, { BackgroundColor3 = red }) end)
				lb.MouseButton1Click:Connect(function()
					if g.Callback then task.spawn(g.Callback, g) end
				end)
			end
		end
		empty.Visible = (shown == 0)
		if #games == 0 then
			emptyTitle.Text = "No games available yet"
			emptySub.Text = "Supported games will show up here once they're added."
		else
			emptyTitle.Text = "No results found"
			emptySub.Text = "Nothing matches \"" .. (box.Text or "") .. "\"."
		end
		countLabel.Text = shown .. " of " .. #games
	end

	box:GetPropertyChangedSignal("Text"):Connect(function()
		clearBtn.Visible = (box.Text ~= "")
		refresh()
	end)

	function Loader:AddGame(g) table.insert(games, g); refresh() end
	function Loader:Refresh() refresh() end
	function Loader:Destroy()
		for _, c in ipairs(conns) do c:Disconnect() end
		conns = {}
		gui:Destroy()
	end

	NeverRage:OnThemeChanged(function(t)
		if not gui.Parent then return end
		red = cfg.Red or t.Panel
		applyGrad()
		mstroke.Color = red:Lerp(Color3.new(0, 0, 0), 0.4)
		refresh()
	end)

	Loader.Gui = gui
	refresh()
	return Loader
end

return NeverRage
