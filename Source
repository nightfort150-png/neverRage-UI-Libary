		local fstroke = Stroke(Theme.Border, 1.2); fstroke.Parent = floatBtn
		local ficon = New("ImageLabel", {
			Size = UDim2.fromOffset(22, 22), BackgroundTransparency = 1, Image = cfg.Logo or "rbxassetid://127179358842282",
			ImageColor3 = (cfg.TintLogo == false) and Color3.new(1, 1, 1) or Theme.Accent,
