		})
		OnAccent(function() if cfg.TintLogo ~= false then ficon.ImageColor3 = Theme.Accent end end)
		local fname = Label({
			Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, RichText = true,
			Text = cfg.ButtonText or titleText(), Font = Theme.FontBold, TextSize = 12, LayoutOrder = 1, ZIndex = 21, Parent = floatBtn,
		})
		OnAccent(function() if not cfg.ButtonText then fname.Text = titleText() end end)
		floatBtn.MouseEnter:Connect(function() Tween(floatBtn, { BackgroundColor3 = Theme.Element2 }); Tween(fstroke, { Color = Theme.Accent }) end)
		floatBtn.MouseLeave:Connect(function() Tween(floatBtn, { BackgroundColor3 = Theme.Element }); Tween(fstroke, { Color = Theme.Border }) end)

		local fdrag, moved, fstart, fpos = false, false, nil, nil
		floatBtn.InputBegan:Connect(function(i)
			if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
				fdrag, moved, fstart, fpos = true, false, i.Position, floatBtn.Position
			end
		end)
		conn(UIS.InputChanged, function(i)
			if fdrag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
				local d = i.Position - fstart
				if d.Magnitude > 6 then moved = true end
				if moved then
					floatBtn.Position = UDim2.new(fpos.X.Scale, fpos.X.Offset + d.X, fpos.Y.Scale, fpos.Y.Offset + d.Y)
				end
			end
		end)
		conn(UIS.InputEnded, function(i)
			if fdrag and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
				fdrag = false
				if not moved then Window:Toggle() end
			end
		end)
	end

	-- menu toggle key
	conn(UIS.InputBegan, function(i, gp)
		if gp or NeverRage._listening then return end
		if i.KeyCode == Window.ToggleKey then Window:Toggle() end
	end)

	local shown = false
	function Window:SetVisible(v)
		if v == shown then return end
		shown = v
		if v then
			main.Visible = true
			uiScale.Scale = curScale() * 0.94
			Tween(uiScale, { Scale = curScale() }, 0.2)
		else
			Tween(uiScale, { Scale = curScale() * 0.94 }, 0.15)
			task.delay(0.16, function() if not shown then main.Visible = false end end)
		end
	end
	function Window:IsVisible() return shown end
	function Window:Toggle()
		if not Window.Loaded then return end
		Window:SetVisible(not shown)
	end
	function Window:SetToggleKey(k) Window.ToggleKey = k end
	function Window:Destroy()
		if Window._destroyed then return end
		Window._destroyed = true
		if cfg.OnClose then pcall(cfg.OnClose) end
		for _, c in ipairs(conns) do c:Disconnect() end
		conns = {}
		gui:Destroy()
		for i, w in ipairs(NeverRage.Windows) do if w == Window then table.remove(NeverRage.Windows, i) break end end
	end
	function Window:SelectTab(tab)
		for _, t in ipairs(Window.Tabs) do t:_render(t == tab) end
		Window.Active = tab
	end

	OnAccent(function()
		logo.Text = titleText()
		if Window.Active then Window:SelectTab(Window.Active) end
	end)

	-- loading splash
	if cfg.Loading ~= false then
		local splash = New("CanvasGroup", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(250, 124),
			BackgroundColor3 = Theme.Window, BorderSizePixel = 0, GroupTransparency = 1, ZIndex = 50, Parent = gui,
		}, { Corner(6), Stroke(Theme.Border) })
		New("UIScale", { Scale = math.min(1.25, baseScale), Parent = splash })
		local sbar = New("Frame", { Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = splash })
		New("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 70, 110)),
				ColorSequenceKeypoint.new(0.22, Color3.fromRGB(255, 190, 50)),
				ColorSequenceKeypoint.new(0.42, Color3.fromRGB(90, 235, 120)),
				ColorSequenceKeypoint.new(0.62, Color3.fromRGB(60, 190, 255)),
				ColorSequenceKeypoint.new(0.82, Color3.fromRGB(150, 90, 255)),
				ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 70, 200)),
			}),
			Parent = sbar,
		})
		New("ImageLabel", {
			AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 16), Size = UDim2.fromOffset(34, 34),
			BackgroundTransparency = 1, Image = cfg.Logo or "rbxassetid://127179358842282",
			ImageColor3 = (cfg.TintLogo == false) and Color3.new(1, 1, 1) or Theme.Accent,
			ScaleType = Enum.ScaleType.Fit, Parent = splash,
		})
		local stitle = Label({ Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 56), RichText = true, Text = titleText(), Font = Theme.FontBold, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Center, Parent = splash })
		local status = Label({ Size = UDim2.new(1, 0, 0, 12), Position = UDim2.fromOffset(0, 78), Text = "", TextSize = 8, TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Center, Parent = splash })
		local track = New("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 100), Size = UDim2.fromOffset(190, 3), BackgroundColor3 = Theme.Track, BorderSizePixel = 0, Parent = splash }, { Corner(2) })
		local fill = New("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Parent = track }, { Corner(2) })

		task.spawn(function()
			local steps = { "Initializing...", "Loading components...", "Building interface...", "Ready" }
			local total = cfg.LoadTime or 1.4
			local per = total / #steps
			pcall(function()
				Tween(splash, { GroupTransparency = 0 }, 0.25)
				for i, txt in ipairs(steps) do
					status.Text = txt
					Tween(fill, { Size = UDim2.fromScale(i / #steps, 1) }, per)
					task.wait(per)
				end
				task.wait(0.15)
				Tween(splash, { GroupTransparency = 1 }, 0.25)
				task.wait(0.27)
				splash:Destroy()
			end)
			Window.Loaded = true
			if gui.Parent then Window:SetVisible(true) end
		end)
	else
		Window:SetVisible(true)
	end

	local tabOrder = 0
	function Window:AddCategory(name)
		tabOrder = tabOrder + 1
		local f = New("Frame", { Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, LayoutOrder = tabOrder, Parent = tabList })
