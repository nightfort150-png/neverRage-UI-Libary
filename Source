				local row = New("TextButton", { Size = UDim2.new(1, 0, 0, 13), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, LayoutOrder = nextOrder(), Parent = sec })
				local box = New("Frame", { Size = UDim2.fromOffset(10, 10), Position = UDim2.fromOffset(0, 1.5), BackgroundColor3 = Theme.Element, BorderSizePixel = 0, Parent = row }, { Corner(2.5) })
				local bstroke = Stroke(Theme.Border); bstroke.Parent = box
				local check = Glyph("check", box, 6, Color3.new(1, 1, 1), 2, 2)
				Label({ Size = UDim2.new(1, -17, 1, 0), Position = UDim2.fromOffset(17, 0), Text = c.Name or "Toggle", TextSize = 9, Parent = row })

				local obj = {}
				local function render()
					check.Holder.Visible = value
					Tween(box, { BackgroundColor3 = value and Theme.Accent or Theme.Element })
					bstroke.Color = value and Theme.Accent or Theme.Border
