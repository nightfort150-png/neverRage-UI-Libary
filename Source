--[[
	NeverRage UI Library  (Roblox / Luau)

	local Window  = NeverRage:CreateWindow({Title="Never", TitleAccent="Rage", Tag="v1.0", Footer="", Accent=Color3, ToggleKey=Enum.KeyCode, Scale=1.3})
	Window:AddCategory("Name")                                  -- small grey heading in the sidebar
	local Tab     = Window:AddTab({Name="", Icon="crosshair", Description=""})
	local Section = Tab:AddSection({Name="", Side="Left"|"Right"})

	Section:AddToggle({Name, Flag, Default, Callback})
	Section:AddSlider({Name, Flag, Min, Max, Default, Increment, Suffix, Callback})
	Section:AddDropdown({Name, Flag, Options, Default, Multi, Callback})
	Section:AddColorPicker({Name, Flag, Default, Callback})     -- hue wheel + saturation/value square
	Section:AddKeybind({Name, Flag, Default, Callback, Changed})
	Section:AddTextBox({Name, Flag, Default, Placeholder, Callback})
	Section:AddButton({Name, Callback})
	Section:AddLabel("text")   Section:AddSeparator()

	Every element returns an object with :Set(v) / :Get().
	NeverRage.Flags[flag]  -> current value      NeverRage.Objects[flag] -> element object
	NeverRage:SetAccent(Color3)   NeverRage:ExportConfig()   NeverRage:ImportConfig(json)
	Window:Notify({Title, Text, Duration})   Window:Destroy()

	Built-in icon names: crosshair sword eye palette user globe dots gear sliders list folder lock
	(or pass "rbxassetid://ID" for your own)
]]

